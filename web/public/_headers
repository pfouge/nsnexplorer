/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; form-action 'self'; upgrade-insecure-requests
  # Open demand updates hourly; keep HTML fresh at the edge without
  # relying on a post-deploy purge. Edge caches for 120s then revalidates;
  # browsers always revalidate. Fingerprinted /_astro/* assets stay immutable
  # (rule below overrides this for that path).
  Cache-Control: public, max-age=0, s-maxage=120, must-revalidate

/embed/*
  # Embeddable charts: frameable by any site. Pages joins the headers of every
  # matching rule, so the site-wide X-Frame-Options and CSP are detached here
  # and one CSP (identical except frame-ancestors) is set in their place.
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors *; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; form-action 'self'; upgrade-insecure-requests

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fsc/*.md
  Content-Type: text/markdown; charset=utf-8

/data/*.csv
  # Prerendered CSV endpoints lose their response headers in the static build,
  # so the download behaviour is declared here.
  Content-Type: text/csv; charset=utf-8
  Content-Disposition: attachment
