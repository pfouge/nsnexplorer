---
// The NSN Explorer logo, inline so it follows the theme: nut and lettering take the text
// colour, the needle takes --logo-accent. Art is generated by brand/build.mjs.
import { LOCKUP, MARK } from '../lib/logo';

interface Props {
  variant?: 'lockup' | 'mark';
  height?: number;
}
const { variant = 'lockup', height = 28 } = Astro.props;
const art = variant === 'mark' ? MARK : LOCKUP;
const width = Math.round(((height * art.w) / art.h) * 100) / 100;
---

<svg class="logo" xmlns="http://www.w3.org/2000/svg" viewBox={art.viewBox} width={width} height={height} aria-hidden="true" focusable="false" set:html={art.body} />
