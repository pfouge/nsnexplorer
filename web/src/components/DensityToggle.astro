---
// DensityToggle.astro — comfortable or compact table rows, for this visit (scripts/disclosure.ts, nsn.density).
// Hidden until the script runs, since it does nothing without it.
---
<div class="density" data-density-toggle role="group" aria-label="Row spacing" hidden>
  <button type="button" value="comfortable" aria-pressed="true">Comfortable</button>
  <button type="button" value="compact" aria-pressed="false">Compact</button>
</div>
