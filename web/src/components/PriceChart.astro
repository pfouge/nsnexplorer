---
// Hand-rolled SVG price-history chart. No chart library. See docs/chart-spec.md.
import type { PointWithSpike } from '../lib/shared';
import { formatDate, formatUsdPrecise } from '../lib/shared';
import { niceTicks, formatTickDollar, computeXTicks } from '../lib/chart';

interface Props {
  points: PointWithSpike[];
  chartId: string;
}

const { points, chartId } = Astro.props;

const sorted = [...points].sort((a, b) => a.awardedOn.localeCompare(b.awardedOn));
const hasChart = sorted.length >= 2;

const W = 880;
const H = 280;
const marginTop = 32;
const marginRight = 20;
const marginBottom = 40;

let svgMarkup = '';

if (hasChart) {
  const prices = sorted.map((p) => p.unitPrice);
  const maxPrice = Math.max(...prices);
  const yTicks = niceTicks(maxPrice, 4);
  const yMax = yTicks[yTicks.length - 1] || 1;

  const tickLabels = yTicks.map(formatTickDollar);
  const longest = Math.max(...tickLabels.map((t) => t.length));
  const marginLeft = Math.max(46, longest * 7.5 + 18);

  const plotWidth = W - marginLeft - marginRight;
  const plotHeight = H - marginTop - marginBottom;

  const dates = sorted.map((p) => new Date(`${p.awardedOn}T00:00:00Z`));
  const minTime = Math.min(...dates.map((d) => d.getTime()));
  const maxTime = Math.max(...dates.map((d) => d.getTime()));
  const timeRange = maxTime - minTime;

  const xScale = (d: Date, idx: number): number => {
    if (timeRange === 0) {
      return sorted.length > 1
        ? marginLeft + (plotWidth * idx) / (sorted.length - 1)
        : marginLeft + plotWidth / 2;
    }
    return marginLeft + ((d.getTime() - minTime) / timeRange) * plotWidth;
  };
  const yScale = (v: number): number => marginTop + (1 - v / yMax) * plotHeight;

  const xTicks = computeXTicks(dates);

  // Spike labels: at most 3, the largest multiples.
  const spikeSorted = [...sorted]
    .filter((p) => p.spikeRatio !== null)
    .sort((a, b) => (b.spikeRatio ?? 0) - (a.spikeRatio ?? 0));
  const labeledIds = new Set(spikeSorted.slice(0, 3).map((p) => p.id));

  const linePoints = sorted
    .map((p, i) => `${xScale(dates[i], i).toFixed(2)},${yScale(p.unitPrice).toFixed(2)}`)
    .join(' L ');
  const linePath = sorted.length >= 3 ? `M ${linePoints}` : '';

  const gridlines = yTicks
    .map((t) => {
      const y = yScale(t).toFixed(2);
      return `<line x1="${marginLeft}" x2="${W - marginRight}" y1="${y}" y2="${y}" style="stroke:var(--line)" stroke-width="1" />` +
        `<text x="${marginLeft - 8}" y="${(Number(y) + 4).toFixed(2)}" text-anchor="end" class="axis-label">${formatTickDollar(t)}</text>`;
    })
    .join('');

  // X tick labels use the same time-based scale as the points themselves
  // (the index-based fallback only applies when every point shares one date,
  // in which case a synthetic single tick at that date is used instead).
  const xAxisLabelsFinal =
    timeRange === 0
      ? `<text x="${(marginLeft + plotWidth / 2).toFixed(2)}" y="${H - marginBottom + 20}" text-anchor="middle" class="axis-label">${xTicks[0]?.label ?? ''}</text>`
      : xTicks
          .map((t) => {
            const x = marginLeft + ((t.time - minTime) / timeRange) * plotWidth;
            return `<text x="${x.toFixed(2)}" y="${H - marginBottom + 20}" text-anchor="middle" class="axis-label">${t.label}</text>`;
          })
          .join('');

  const escapeAttr = (s: string): string =>
    s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  const dotMarkup = sorted
    .map((p, i) => {
      const cx = xScale(dates[i], i);
      const cy = yScale(p.unitPrice);
      const isSpike = p.spikeRatio !== null;
      const color = isSpike ? 'var(--red)' : 'var(--green)';
      const labeled = labeledIds.has(p.id);
      const ariaLabel = `${formatDate(p.awardedOn)}, ${formatUsdPrecise(p.unitPrice)} per unit${isSpike ? ', price spike' : ''}`;
      const label = labeled
        ? `<text x="${cx.toFixed(2)}" y="${(cy - 12).toFixed(2)}" text-anchor="middle" class="spike-label">${p.spikeRatio!.toFixed(1)}× median</text>`
        : '';
      return `<a href="${escapeAttr(p.sourceUrl)}" target="_blank" rel="noopener noreferrer" class="price-dot" tabindex="0"
          data-date="${p.awardedOn}" data-price="${p.unitPrice}" data-qty="${p.quantity ?? ''}"
          data-supplier="${escapeAttr(p.supplierName ?? 'Unknown supplier')}" data-cage="${p.cage ?? ''}"
          data-agency="${escapeAttr(p.agencyName ?? 'Unknown agency')}" data-spike="${p.spikeRatio ?? ''}"
          aria-label="${escapeAttr(ariaLabel)}">
          <circle class="hit" cx="${cx.toFixed(2)}" cy="${cy.toFixed(2)}" r="12" fill="transparent" />
          <circle class="dot" cx="${cx.toFixed(2)}" cy="${cy.toFixed(2)}" r="5" style="fill:${color};stroke:var(--card)" stroke-width="2" />
          ${label}
        </a>`;
    })
    .join('');

  svgMarkup = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Unit price history, ${sorted.length} purchases">
      <g class="gridlines">${gridlines}</g>
      <g class="xaxis">${xAxisLabelsFinal}</g>
      ${linePath ? `<path d="${linePath}" fill="none" style="stroke:var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />` : ''}
      <g class="points">${dotMarkup}</g>
    </svg>`;
}
---

<div class="price-chart" data-chart-root data-chart-id={chartId}>
  <h3>What the government paid per unit</h3>
  {hasChart ? (
    <>
      <Fragment set:html={svgMarkup} />
      <div class="chart-tooltip" data-tooltip role="status" aria-live="polite"></div>
    </>
  ) : (
    <p class="no-chart">Fewer than two priced purchases on record — see the table below.</p>
  )}
</div>
<script src="../scripts/priceChart.ts"></script>
