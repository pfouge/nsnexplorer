---
import '../styles/global.css';
import '../styles/viz.css';
import SEO from '../components/SEO.astro';
import Logo from '../components/Logo.astro';
import FreshnessStrip from '../components/viz/FreshnessStrip.astro';
import { SITE_NAME } from '../consts';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonicalUrl?: string;
  noindex?: boolean | 'follow';
  pageType?: string;
  extraSchema?: object[];
  breadcrumbs?: { name: string; url: string }[];
  itemList?: { name: string; items: { name: string; url: string }[] };
  faq?: { question: string; answer: string }[];
  headLinks?: { rel: string; href: string; type?: string }[];
}

const seoProps = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FAF8F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0F10" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Set theme before first paint: explicit choice wins, else follow OS.
      (() => {
        const saved = localStorage.getItem('theme');
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.dataset.theme = 'dark';
      })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />

    <SEO {...seoProps} />

    <!-- Google Analytics 4 (gtag.js). Loads for all visitors; a cookie
         consent banner / consent mode can be layered on later. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-V0L6VYP0B4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-V0L6VYP0B4');
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="site">
      <div class="container">
        <a class="brand" href="/" aria-label={`${SITE_NAME} home`}>
          <Logo height={28} />
        </a>
        <nav class="site" aria-label="Site">
          <a href="/open/">Open Demand</a>
          <a href="/services/">Services</a>
          <a href="/suppliers/">For Suppliers</a>
          <a href="/catalog/">Catalog</a>
          <a href="/browse/">Browse</a>
          <a href="/agencies/">Agencies</a>
          <a href="/methodology/">Methodology</a>
          <a href="/about/">About</a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch color theme">
            Dark
          </button>
        </nav>
      </div>
    </header>

    <div class="viz-tape" id="demand-tape" role="region" hidden aria-label="Newest solicitations"></div>

    <main id="main-content" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site">
      <div class="container">
        <div class="foot-top">
          <Logo height={24} />
        </div>
        <p class="data-honesty">
          Every price on this site comes from a public U.S. government record, and every figure
          links to its source.
        </p>
        <p class="disclaimer">
          NSN Explorer publishes public procurement data for suppliers, buyers, and researchers. It
          sells nothing and offers no recommendations. Figures reflect official records, which may
          lag actual events.
        </p>
        <FreshnessStrip heading="Data freshness" />
        <nav aria-label="Footer">
          <a href="/open/">Open Demand</a>
          <a href="/services/">Services</a>
          <a href="/suppliers/">For Suppliers</a>
          <a href="/browse/">Browse deep categories</a>
          <a href="/agencies/">Agencies</a>
          <a href="/methodology/">Methodology</a>
          <a href="/compare/">Compare items</a>
          <a href="/about/">About</a>
          <a href="/terms/">Terms</a>
          <a href="/privacy/">Privacy</a>
        </nav>
        <p style="margin-top:1.25rem">© {year} nsnexplorer.com</p>
      </div>
    </footer>
    <script is:inline>
      // Theme switching, ported from the followthemoney heatmap: the button
      // shows the theme you'd switch to; an explicit choice persists and
      // stops OS-preference tracking.
      (() => {
        const root = document.documentElement;
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const sync = () => {
          const dark = root.dataset.theme === 'dark';
          btn.textContent = dark ? 'Light' : 'Dark';
          btn.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`);
        };
        sync();
        btn.addEventListener('click', () => {
          const dark = root.dataset.theme !== 'dark';
          if (dark) root.dataset.theme = 'dark';
          else delete root.dataset.theme;
          localStorage.setItem('theme', dark ? 'dark' : 'light');
          sync();
        });
        const mq = matchMedia('(prefers-color-scheme: dark)');
        mq.addEventListener('change', (e) => {
          if (localStorage.getItem('theme')) return;
          if (e.matches) root.dataset.theme = 'dark';
          else delete root.dataset.theme;
          sync();
        });
      })();
    </script>
    <script>
      import '../scripts/viz.ts';
      import '../scripts/tape.ts';
      import '../scripts/freshness.ts';
    </script>
  </body>
</html>
