---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdUnit from '../components/AdUnit.astro';
import { loadSiteData, formatUsd } from '../lib/data';
import { SITE_URL } from '../consts';
import CiteThis from '../components/CiteThis.astro';

const data = await loadSiteData();
// Ranked by obligated dollars on USAspending contract actions (the figure the
// agency page leads with), highest first; ties by name. Price-point purchases
// are shown in their own column only when some agency has any.
const rows = data.agencies
  .map((a) => {
    const purchases = data.purchasesByAgency.get(a.agencyId) ?? [];
    const prof = data.agencyProfiles.get(a.agencyId);
    return {
      agency: a,
      count: purchases.length,
      actions: prof?.actions ?? 0,
      obligated: prof?.obligated ?? 0,
    };
  })
  .sort((a, b) => b.obligated - a.obligated || a.agency.name.localeCompare(b.agency.name));

const fmtInt = (n: number) => n.toLocaleString('en-US');

const A = rows.length;
const P = rows.reduce((s, r) => s + r.actions, 0);
const hasPurchases = rows.some((r) => r.count > 0);
const hasA = A > 0;

const title = hasA
  ? `Federal Parts Spending by Agency: ${fmtInt(A)} Agencies`
  : 'Federal Parts Spending by Agency';
const description = hasA
  ? `Federal parts spending by agency: ${fmtInt(A)} government agencies ranked by obligated dollars on contract actions, from USAspending records. Free, updated daily.`
  : 'Federal parts spending by agency: which government agencies buy parts, ranked by obligated dollars on USAspending contract actions. Free, updated daily.';
const h1 = hasA
  ? `Federal parts spending by agency: ${fmtInt(A)} agencies, ${fmtInt(P)} contract actions`
  : 'Federal parts spending by agency';
const canonicalUrl = `${SITE_URL}/agencies/`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Agencies', url: canonicalUrl },
];

const itemList = {
  name: 'Government agencies with indexed parts purchases',
  items: rows.map((r) => ({ name: r.agency.name, url: `/agency/${r.agency.slug}/` })),
};

const faq = [
  {
    question: 'Which government agencies buy the most parts?',
    answer:
      'In these records the Defense Logistics Agency and the military services account for most parts purchases. The table ranks every indexed agency by obligated dollars on contract actions.',
  },
  {
    question: 'Why is an agency missing?',
    answer:
      'Only agencies named as the buyer on an indexed contract action or price point appear. As more federal supply classes are fully indexed, more agencies will show up.',
  },
  {
    question: 'Is this total federal spending?',
    answer:
      "No. It covers USAspending contract actions for the supply classes indexed here, not an agency's whole budget.",
  },
];
---

<BaseLayout
  ads={rows.length > 0}
  title={title}
  description={description}
  pageType="CollectionPage"
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
  itemList={itemList}
  faq={faq}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › Agencies
  </nav>

  <p class="eyebrow">Buyers</p>
  <h1>{h1}</h1>
  <p class="lede">Agencies</p>
  <p class="lede">
    Every agency that appears as the buyer on an indexed contract action, with a link to what it buys.
  </p>

  <section class="intro">
    <h2 class="section-title">Which government agencies buy parts</h2>
    <p class="gloss">
      This page shows federal parts spending by agency: every government agency that appears as
      the buyer on an indexed USAspending contract action, ranked by obligated dollars. Open an
      agency to see its suppliers, the supply classes it buys, spending by fiscal year and its
      latest actions, each linked to the source record. Totals cover the supply classes NSN
      Explorer tracks, not an agency's whole budget, and include negative de-obligations. The index
      is rebuilt every day, and it is free to use.
    </p>
  </section>

  {rows.length === 0 ? (
    <p class="gloss">No agencies indexed yet.</p>
  ) : (
    <>
    <p class="gloss">Figures cover only the supply classes NSN Explorer tracks, so they are not each agency's whole spending.</p>
    <ul class="chips wrap-wide" aria-label="Free downloads">
      <li><a class="chip outline" href="/data/agencies.csv" download>Download CSV</a></li>
    </ul>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Agency</th>
            <th class="num">Contract actions</th>
            <th class="num">Obligated</th>
            {hasPurchases && <th class="num">Purchases</th>}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td><a href={`/agency/${r.agency.slug}/`}>{r.agency.name}</a></td>
              <td class="num mono">{fmtInt(r.actions)}</td>
              <td class="num mono">{r.actions > 0 ? formatUsd(r.obligated) : '—'}</td>
              {hasPurchases && <td class="num mono">{fmtInt(r.count)}</td>}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    </>
  )}

  <AdUnit position="mid" on={rows.length > 0} />

  <section class="faq">
    <h2 class="section-title">Agency spending questions</h2>
    {faq.map((f) => (
      <>
        <h3>{f.question}</h3>
        <p class="gloss">{f.answer}</p>
      </>
    ))}
  </section>

  <CiteThis title={h1} url={canonicalUrl} asOf={data.viz.today} />
</BaseLayout>
