---
// solicitation/[sol].astro — per-solicitation detail page. Deep-link/SEO
// target for one government solicitation: a public procurement notice,
// not a sale, so no Offer/Product commerce schema — consistent with the
// site's "not commerce" stance.
//
// Rendered ON REQUEST (like nsn/[nsn].astro) for every status (open, awarded,
// expired, ...) and both sources (dibbs_rfq, sam_gov), so the "closes in N
// days" countdown is computed per request, not at build time.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CiteThis from '../../components/CiteThis.astro';
import Follow from '../../components/Follow.astro';
import BidCalculator from '../../components/BidCalculator.astro';
import DrawingsBlock from '../../components/DrawingsBlock.astro';
import { SITE_URL } from '../../consts';
import { toDashedNsn, formatDate, formatUsd, formatUsdPrecise, parseCharacteristics } from '../../lib/shared';
import { databaseUrlFrom } from '../../lib/runtime-env';
import { openSql } from '../../lib/nsn-page';
import { loadSolicitationPage } from '../../lib/solicitation-page';
import { countdownBadge, daysUntilClose, isSolNumber, solicitationPath, statusBadge, supplierPath } from '../../lib/entity';
import { priceSummary, repeatWinner, valueAtLastPrice, winners } from '../../lib/sol-history';
import { CEILING_LABEL, ceilingAmountText } from '../../lib/contract-ceiling';
import { twinLine } from '../../lib/sol-twin';
import { collectStandardDocs } from '../../lib/standard-refs';
import { drawingsBlock } from '../../lib/drawings-copy';
import { buildDiagram } from '../../lib/diagram';

export const prerender = false;

const solParam = Astro.params.sol ?? '';
const notFound = (): Response => {
  return new Response(null, { status: 404, headers: { 'Cache-Control': 'public, s-maxage=300' } });
};
// RFQ and notice numbers are letters, digits and dashes; anything else cannot exist.
if (!isSolNumber(solParam)) return notFound();

const databaseUrl = databaseUrlFrom(Astro);
if (!databaseUrl) {
  return new Response('Database is not configured for this environment.', { status: 503 });
}
const sql = openSql(databaseUrl);
let page;
try {
  page = await loadSolicitationPage(sql, solParam);
} finally {
  await sql.end({ timeout: 1 }).catch(() => {});
}
if (!page) return notFound();
// Shorter edge cache than NSN pages: the countdown and status change daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=600, stale-while-revalidate=3600');

const { sol, awards, fscName, hasOpenPage, purchaseRequest, techDocs, partPrices, partPriceCount, matchedAwards, twin } = page;
const isOpen = sol.status === 'open';
const dashed = sol.nsn ? toDashedNsn(sol.nsn) : null;
const itemLabel = sol.nomenclature ?? sol.itemName ?? sol.solNumber;
const sourceName = sol.source === 'sam_gov' ? 'SAM.gov' : 'DIBBS';

const techDocsLabel = techDocs === 'tech_docs' ? 'Listed on DIBBS' : techDocs === 'spec_only' ? 'Spec or standard only' : techDocs === 'none' ? 'None listed' : null;
// Base awards of long-term contracts (lib/contract-ceiling.ts) carry a ceiling, not a price: they stay in
// the winners and award lists, and are left out of every price figure.
const pricedParts = partPrices.filter((p) => !p.isCeiling);
const summary = priceSummary(pricedParts);
const lastPriceValue = valueAtLastPrice(sol.quantity, summary?.latest ?? null);
const lastPricePoint = summary
  ? ([...pricedParts].sort((a, b) => (a.awardedOn < b.awardedOn ? 1 : a.awardedOn > b.awardedOn ? -1 : 0)).find((p) => p.unitPrice === summary.latest) ?? null)
  : null;
const winnerRows = winners(partPrices).slice(0, 8);
const repeat = repeatWinner(partPrices);
const priceRows = pricedParts.slice(0, 10);

// "Drawings and technical data" (DIBBS rows only): official pointers, never a copy of any drawing. The part's standard
// documents (MS/AN/NAS sheets, MIL specs) come from its part numbers and FLIS characteristics; the generated diagram is
// the same one the part page shows, with its "drawn from catalog data" caveat.
const characteristics = parseCharacteristics(page.characteristics);
const standardDocs = collectStandardDocs({ characteristics, partNumbers: page.partNumbers });
const drawings = drawingsBlock(techDocs, sol.source, standardDocs.length > 0, sol.sourceUrl);
const drawingDiagram =
  drawings && dashed && sol.fsc ? buildDiagram(characteristics, sol.fsc, { nsnDashed: dashed, itemName: page.sol.itemName }) : null;

const status = statusBadge(sol.status);
const countdown = isOpen ? countdownBadge(daysUntilClose(sol.returnBy, new Date())) : null;

const qty = sol.quantity !== null ? ` quantity ${sol.quantity.toLocaleString('en-US')}` : '';
const title = `${itemLabel} — ${isOpen ? 'Open solicitation' : 'Solicitation'} ${sol.solNumber}`;
const description = `${isOpen ? 'Open government' : 'Government'} solicitation ${sol.solNumber}${
  sol.nomenclature ? ` for ${sol.nomenclature}` : ''
}${qty ? `,${qty}` : ''}${
  sol.returnBy ? `, ${isOpen ? 'closes' : 'closed'} ${formatDate(sol.returnBy)}` : ''
} — ${isOpen ? 'bid via' : 'see'} the official ${sourceName} record.`;
const canonicalUrl = `${SITE_URL}/solicitation/${sol.solNumber}/`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Open demand', item: `${SITE_URL}/open/` },
    { '@type': 'ListItem', position: 3, name: sol.solNumber, item: canonicalUrl },
  ],
};

// The same requirement posted on the other source (sol-twin.ts): one short line, official record linked.
const twinText = twin ? twinLine(twin.source, twin.solNumber) : null;
const twinOtherName = twin ? (twin.source === 'sam_gov' ? 'SAM.gov' : 'DIBBS') : null;

const primaryLabel = isOpen
  ? sol.source === 'sam_gov'
    ? 'View this notice at SAM.gov →'
    : 'View & bid on this RFQ at DIBBS →'
  : `View the official record at ${sourceName} →`;
---

<BaseLayout
  title={title}
  description={description}
  pageType="WebPage"
  canonicalUrl={canonicalUrl}
  extraSchema={[breadcrumbSchema]}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › <a href="/open/">Open demand</a> › {sol.solNumber}
  </nav>

  <p class="eyebrow">{isOpen ? 'Open solicitation' : 'Solicitation'} <span class="x">×</span> {sol.solNumber}</p>

  <header class="hero">
    <h1>{itemLabel}</h1>
    <p class="ident">
      <span class="code">{sol.solNumber}</span>
      <span class:list={['badge', status.cls]}>{status.text}</span>
      {countdown && <span class:list={['badge', countdown.cls]}>{countdown.text}</span>}
    </p>
    {twin && twinText && (
      <p class="twin-note">
        {twinText.prefix} <a class="mono" href={`/solicitation/${twin.solNumber}/`}>{twinText.label}</a>.
        <a class="twin-ext" href={twin.sourceUrl} target="_blank" rel="nofollow noopener">View at {twinOtherName} →</a>
      </p>
    )}
    <Follow kind="solicitation" entity={sol.solNumber} label={`${sol.solNumber} ${itemLabel}`.slice(0, 200)} />
  </header>

  <div class="stat-strip roomy">
    <div class="stat">
      <div class="value">
        {sol.quantity !== null ? sol.quantity.toLocaleString('en-US') : '—'}
        {sol.unitOfIssue && <span class="gloss" style="font-size:0.9rem;"> {sol.unitOfIssue}</span>}
      </div>
      <div class="label">Quantity</div>
    </div>
    <div class="stat">
      <div class="value">{sol.issuedOn ? formatDate(sol.issuedOn) : '—'}</div>
      <div class="label">Issued</div>
    </div>
    <div class="stat">
      <div class="value">{sol.returnBy ? formatDate(sol.returnBy) : '—'}</div>
      <div class="label">Return by</div>
    </div>
    {dashed && (
      <div class="stat">
        <div class="value"><a class="mono" href={`/nsn/${dashed}/`}>{dashed}</a></div>
        <div class="label">NSN</div>
      </div>
    )}
    {purchaseRequest && (
      <div class="stat">
        <div class="value mono">{purchaseRequest}</div>
        <div class="label">Purchase request</div>
      </div>
    )}
    {techDocsLabel && (
      <div class="stat">
        <div class="value">{techDocsLabel}</div>
        <div class="label">Tech docs</div>
      </div>
    )}
    {lastPriceValue !== null && (
      <div class="stat">
        <div class="value">≈ {formatUsd(Math.round(lastPriceValue))}</div>
        <div class="label">Value at last price</div>
        <div class="gloss">Quantity × last unit price</div>
      </div>
    )}
    {sol.setaside && (
      <div class="stat">
        <div class="value">{sol.setaside}</div>
        <div class="label">Set-aside</div>
      </div>
    )}
    {sol.buyerOffice && (
      <div class="stat">
        <div class="value">{sol.buyerOffice}</div>
        <div class="label">Buyer office</div>
      </div>
    )}
  </div>

  <p style="margin:1.25rem 0 0; display:flex; gap:0.75rem; flex-wrap:wrap;">
    <a class="btn" href={sol.sourceUrl} target="_blank" rel="nofollow noopener">{primaryLabel}</a>
    {dashed && (
      <a class="btn btn-ghost" href={`/nsn/${dashed}/`}>
        See price history &amp; specs for this part →
      </a>
    )}
    {hasOpenPage && sol.fsc && (
      <a class="btn btn-ghost" href={`/open/${sol.fsc}/`}>
        Solicitations in FSC {sol.fsc}{fscName ? ` ${fscName}` : ''} →
      </a>
    )}
  </p>

  {drawings && <DrawingsBlock block={drawings} docs={standardDocs} diagram={drawingDiagram} />}
  {/* INSERTION POINT (SAM.gov rows): notice attachments and resource links for source === 'sam_gov' are handled by another
      change. drawingsBlock() returns null for sam_gov on purpose; nothing here reads raw notice attachments. */}

  {matchedAwards.length > 0 && (
    <section id="award-on-record">
      <h2 class="section-title">Award on record for this purchase request</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Awarded</th>
              <th>Award number</th>
              <th>Supplier</th>
              <th class="num">Total</th>
            </tr>
          </thead>
          <tbody>
            {matchedAwards.map((m) => {
              const href = supplierPath(m.cage);
              return (
                <tr>
                  <td class="mono">{m.actionDate ? formatDate(m.actionDate) : '—'}</td>
                  <td>
                    <a class="mono" href={m.sourceUrl} target="_blank" rel="nofollow noopener">{m.awardNumber ?? 'Award record'}</a>
                    {m.deliveryOrder && <span class="cage"> (order {m.deliveryOrder})</span>}
                  </td>
                  <td>
                    {href ? <a href={href}>{m.supplierName ?? `CAGE ${m.cage}`}</a> : (m.supplierName ?? m.cage ?? 'Unknown')}
                    {m.cage && m.supplierName && <span class="cage"> ({m.cage})</span>}
                  </td>
                  <td class="num price">{m.total === null ? '—' : m.isCeiling ? <>{ceilingAmountText(formatUsd(m.total))} <span class="badge">{CEILING_LABEL}</span></> : formatUsd(m.total)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="gloss">Matched by purchase request number in DIBBS award records.</p>
    </section>
  )}

  {pricedParts.length > 0 && (
    <section id="part-prices">
      <h2 class="section-title">What this part has sold for</h2>
      {summary && (
        <p class="gloss">
          Last {summary.n} award{summary.n === 1 ? '' : 's'}: {formatUsdPrecise(summary.low)} – {formatUsdPrecise(summary.high)}, average {formatUsdPrecise(summary.average)}; most recent {formatUsdPrecise(summary.latest)} on {formatDate(pricedParts[0].awardedOn)}
        </p>
      )}
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Awarded</th>
              <th class="num">Unit price</th>
              <th class="num">Qty</th>
              <th>Supplier</th>
              <th>Solicitation</th>
            </tr>
          </thead>
          <tbody>
            {priceRows.map((p) => {
              const href = supplierPath(p.cage);
              const solHref = p.solNumber && p.solNumber !== sol.solNumber ? solicitationPath(p.solNumber) : null;
              return (
                <tr>
                  <td class="mono">{formatDate(p.awardedOn)}</td>
                  <td class="num price"><a href={p.sourceUrl} target="_blank" rel="nofollow noopener">{formatUsdPrecise(p.unitPrice)}</a></td>
                  <td class="num mono">{p.quantity !== null ? p.quantity.toLocaleString('en-US') : '—'}</td>
                  <td>
                    {href ? <a href={href}>{p.supplierName ?? `CAGE ${p.cage}`}</a> : (p.supplierName ?? 'Unknown')}
                    {p.cage && p.supplierName && <span class="cage"> ({p.cage})</span>}
                  </td>
                  <td class="mono">{solHref ? <a href={solHref}>{p.solNumber}</a> : (p.solNumber ?? '—')}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      {dashed && partPriceCount > priceRows.length && (
        <p><a href={`/nsn/${dashed}/#prices`}>All {partPriceCount.toLocaleString('en-US')} prices on the part page →</a></p>
      )}
    </section>
  )}

  <BidCalculator
    context="solicitation"
    quantity={sol.quantity}
    unitOfIssue={sol.unitOfIssue}
    summary={summary}
    latestAwardedOn={lastPricePoint?.awardedOn ?? null}
    latestSourceUrl={lastPricePoint?.sourceUrl ?? null}
  />

  {winnerRows.length > 0 && (
    <section id="winners">
      <h2 class="section-title">Who has won this part</h2>
      {repeat && (
        <p><span class="badge amber">Same supplier on the last {repeat.streak} awards on record</span></p>
      )}
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Supplier</th>
              <th class="num">Wins</th>
              <th>Last won</th>
              <th class="num">Last price</th>
            </tr>
          </thead>
          <tbody>
            {winnerRows.map((w) => {
              const href = supplierPath(w.cage);
              const last = partPrices.find((p) => p.cage === w.cage && p.awardedOn === w.lastWon && p.unitPrice === w.lastPrice);
              return (
                <tr>
                  <td>
                    {href ? <a href={href}>{w.supplierName ?? `CAGE ${w.cage}`}</a> : (w.supplierName ?? w.cage)}
                    {w.supplierName && <span class="cage"> ({w.cage})</span>}
                  </td>
                  <td class="num mono">{w.wins}</td>
                  <td class="mono">{formatDate(w.lastWon)}</td>
                  <td class="num price">{last?.isCeiling ? <a href={last.sourceUrl} target="_blank" rel="nofollow noopener">{CEILING_LABEL}</a> : last ? <a href={last.sourceUrl} target="_blank" rel="nofollow noopener">{formatUsdPrecise(w.lastPrice)}</a> : formatUsdPrecise(w.lastPrice)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {awards.length > 0 && (
    <section id="awards">
      <h2 class="section-title">Awards on this solicitation</h2>
      <div class="table-wrap">
        <table>
          <caption>{awards.length} award{awards.length === 1 ? '' : 's'} on record that cite {sol.solNumber}</caption>
          <thead>
            <tr>
              <th>Awarded</th>
              <th>Supplier</th>
              <th class="num">Unit price</th>
              <th class="num">Qty</th>
            </tr>
          </thead>
          <tbody>
            {awards.map((a) => {
              const href = supplierPath(a.cage);
              return (
                <tr>
                  <td class="mono">{formatDate(a.awardedOn)}</td>
                  <td>
                    {href ? <a href={href}>{a.supplierName ?? `CAGE ${a.cage}`}</a> : (a.supplierName ?? 'Unknown')}
                    {a.cage && a.supplierName && <span class="cage"> ({a.cage})</span>}
                  </td>
                  <td class="num price">{a.isCeiling ? <>{a.ceilingAmount !== null ? <>{ceilingAmountText(formatUsd(a.ceilingAmount))} </> : null}<span class="badge">{CEILING_LABEL}</span></> : formatUsdPrecise(a.unitPrice)}</td>
                  <td class="num mono">{!a.isCeiling && a.quantity !== null ? a.quantity.toLocaleString('en-US') : '—'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="card" style="margin-top:2rem;">
    <h2>About this data / source</h2>
    <ul class="gloss">
      <li>
        Solicitation record: <a href={sol.sourceUrl} target="_blank" rel="nofollow noopener">{sourceName}</a>.
      </li>
      <li>Status and close date reflect the last time our crawler observed this record — always confirm current status on {sourceName} before bidding.</li>
      {awards.length > 0 && <li>Awards listed here are indexed award records that cite this solicitation number; each links to its supplier page.</li>}
      <li><a href="/methodology/">Full methodology →</a></li>
    </ul>
    <CiteThis title={`${itemLabel}, solicitation ${sol.solNumber}`} url={canonicalUrl} asOf={new Date().toISOString().slice(0, 10)} />
  </section>
</BaseLayout>

<style>
  .twin-note {
    margin: 0.5rem 0 0;
    max-width: 100%;
    font-size: 0.92rem;
    overflow-wrap: anywhere;
  }
  .twin-note a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .twin-note .twin-ext {
    margin-left: 0.4rem;
    white-space: nowrap;
  }
</style>
