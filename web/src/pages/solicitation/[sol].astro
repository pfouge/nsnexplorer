---
// solicitation/[sol].astro — per-solicitation detail page. Deep-link/SEO
// target for one government solicitation: a public procurement notice,
// not a sale, so no Offer/Product commerce schema — consistent with the
// site's "not commerce" stance.
//
// Rendered ON REQUEST (like nsn/[nsn].astro) for every status (open, awarded,
// expired, ...) and both sources (dibbs_rfq, sam_gov), so the "closes in N
// days" countdown is computed per request, not at build time.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CiteThis from '../../components/CiteThis.astro';
import { SITE_URL } from '../../consts';
import { toDashedNsn, formatDate, formatUsdPrecise } from '../../lib/shared';
import { databaseUrlFrom } from '../../lib/runtime-env';
import { openSql } from '../../lib/nsn-page';
import { loadSolicitationPage } from '../../lib/solicitation-page';
import { countdownBadge, daysUntilClose, isSolNumber, statusBadge, supplierPath } from '../../lib/entity';

export const prerender = false;

const solParam = Astro.params.sol ?? '';
const notFound = (): Response => {
  return new Response(null, { status: 404, headers: { 'Cache-Control': 'public, s-maxage=300' } });
};
// RFQ and notice numbers are letters, digits and dashes; anything else cannot exist.
if (!isSolNumber(solParam)) return notFound();

const databaseUrl = databaseUrlFrom(Astro);
if (!databaseUrl) {
  return new Response('Database is not configured for this environment.', { status: 503 });
}
const sql = openSql(databaseUrl);
let page;
try {
  page = await loadSolicitationPage(sql, solParam);
} finally {
  await sql.end({ timeout: 1 }).catch(() => {});
}
if (!page) return notFound();
// Shorter edge cache than NSN pages: the countdown and status change daily.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=600, stale-while-revalidate=3600');

const { sol, awards, fscName, hasOpenPage } = page;
const isOpen = sol.status === 'open';
const dashed = sol.nsn ? toDashedNsn(sol.nsn) : null;
const itemLabel = sol.nomenclature ?? sol.itemName ?? sol.solNumber;
const sourceName = sol.source === 'sam_gov' ? 'SAM.gov' : 'DIBBS';

const status = statusBadge(sol.status);
const countdown = isOpen ? countdownBadge(daysUntilClose(sol.returnBy, new Date())) : null;

const qty = sol.quantity !== null ? ` quantity ${sol.quantity.toLocaleString('en-US')}` : '';
const title = `${itemLabel} — ${isOpen ? 'Open solicitation' : 'Solicitation'} ${sol.solNumber}`;
const description = `${isOpen ? 'Open government' : 'Government'} solicitation ${sol.solNumber}${
  sol.nomenclature ? ` for ${sol.nomenclature}` : ''
}${qty ? `,${qty}` : ''}${
  sol.returnBy ? `, ${isOpen ? 'closes' : 'closed'} ${formatDate(sol.returnBy)}` : ''
} — ${isOpen ? 'bid via' : 'see'} the official ${sourceName} record.`;
const canonicalUrl = `${SITE_URL}/solicitation/${sol.solNumber}/`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Open demand', item: `${SITE_URL}/open/` },
    { '@type': 'ListItem', position: 3, name: sol.solNumber, item: canonicalUrl },
  ],
};

const primaryLabel = isOpen
  ? sol.source === 'sam_gov'
    ? 'View this notice at SAM.gov →'
    : 'View & bid on this RFQ at DIBBS →'
  : `View the official record at ${sourceName} →`;
---

<BaseLayout
  title={title}
  description={description}
  pageType="WebPage"
  canonicalUrl={canonicalUrl}
  extraSchema={[breadcrumbSchema]}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › <a href="/open/">Open demand</a> › {sol.solNumber}
  </nav>

  <p class="eyebrow">{isOpen ? 'Open solicitation' : 'Solicitation'} <span class="x">×</span> {sol.solNumber}</p>

  <header class="hero">
    <h1>{itemLabel}</h1>
    <p class="ident">
      <span class="code">{sol.solNumber}</span>
      <span class:list={['badge', status.cls]}>{status.text}</span>
      {countdown && <span class:list={['badge', countdown.cls]}>{countdown.text}</span>}
    </p>
  </header>

  <div class="stat-strip">
    <div class="stat">
      <div class="value">
        {sol.quantity !== null ? sol.quantity.toLocaleString('en-US') : '—'}
        {sol.unitOfIssue && <span class="gloss" style="font-size:0.9rem;"> {sol.unitOfIssue}</span>}
      </div>
      <div class="label">Quantity</div>
    </div>
    <div class="stat">
      <div class="value">{sol.issuedOn ? formatDate(sol.issuedOn) : '—'}</div>
      <div class="label">Issued</div>
    </div>
    <div class="stat">
      <div class="value">{sol.returnBy ? formatDate(sol.returnBy) : '—'}</div>
      <div class="label">Return by</div>
    </div>
    {dashed && (
      <div class="stat">
        <div class="value"><a class="mono" href={`/nsn/${dashed}/`}>{dashed}</a></div>
        <div class="label">NSN</div>
      </div>
    )}
    {sol.setaside && (
      <div class="stat">
        <div class="value">{sol.setaside}</div>
        <div class="label">Set-aside</div>
      </div>
    )}
    {sol.buyerOffice && (
      <div class="stat">
        <div class="value">{sol.buyerOffice}</div>
        <div class="label">Buyer office</div>
      </div>
    )}
  </div>

  <p style="margin:1.25rem 0 0; display:flex; gap:0.75rem; flex-wrap:wrap;">
    <a class="btn" href={sol.sourceUrl} target="_blank" rel="nofollow noopener">{primaryLabel}</a>
    {dashed && (
      <a class="btn btn-ghost" href={`/nsn/${dashed}/`}>
        See price history &amp; specs for this part →
      </a>
    )}
    {hasOpenPage && sol.fsc && (
      <a class="btn btn-ghost" href={`/open/${sol.fsc}/`}>
        Solicitations in FSC {sol.fsc}{fscName ? ` ${fscName}` : ''} →
      </a>
    )}
  </p>

  {awards.length > 0 && (
    <section id="awards">
      <h2 class="section-title">Awards on this solicitation</h2>
      <div class="table-wrap">
        <table>
          <caption>{awards.length} award{awards.length === 1 ? '' : 's'} on record that cite {sol.solNumber}</caption>
          <thead>
            <tr>
              <th>Awarded</th>
              <th>Supplier</th>
              <th class="num">Unit price</th>
              <th class="num">Qty</th>
            </tr>
          </thead>
          <tbody>
            {awards.map((a) => {
              const href = supplierPath(a.cage);
              return (
                <tr>
                  <td class="mono">{formatDate(a.awardedOn)}</td>
                  <td>
                    {href ? <a href={href}>{a.supplierName ?? `CAGE ${a.cage}`}</a> : (a.supplierName ?? 'Unknown')}
                    {a.cage && a.supplierName && <span class="cage"> ({a.cage})</span>}
                  </td>
                  <td class="num price">{formatUsdPrecise(a.unitPrice)}</td>
                  <td class="num mono">{a.quantity !== null ? a.quantity.toLocaleString('en-US') : '—'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="card" style="margin-top:2rem;">
    <h2>About this data / source</h2>
    <ul class="gloss">
      <li>
        Solicitation record: <a href={sol.sourceUrl} target="_blank" rel="nofollow noopener">{sourceName}</a>.
      </li>
      <li>Status and close date reflect the last time our crawler observed this record — always confirm current status on {sourceName} before bidding.</li>
      {awards.length > 0 && <li>Awards listed here are indexed award records that cite this solicitation number; each links to its supplier page.</li>}
      <li><a href="/methodology/">Full methodology →</a></li>
    </ul>
    <CiteThis title={`${itemLabel}, solicitation ${sol.solNumber}`} url={canonicalUrl} asOf={new Date().toISOString().slice(0, 10)} />
  </section>
</BaseLayout>
