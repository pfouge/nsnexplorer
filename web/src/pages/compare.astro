---
// /compare/ — up to three NSNs side by side on one price scale. Prerendered:
// the page is only the form and a mount point; the bundled script reads
// location.hash, fetches /api/nsn/<nsn>.json for each item and draws the panels.
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../consts';

const canonicalUrl = `${SITE_URL}/compare/`;
const breadcrumbs = [
  { name: 'Home', url: `${SITE_URL}/` },
  { name: 'Compare', url: canonicalUrl },
];
---

<BaseLayout
  title="Compare NSNs: Price History Side by Side"
  description="Compare up to three National Stock Numbers side by side: unit price history, open solicitations and competition status. Free, from public government records."
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › Compare
  </nav>

  <h1>Compare NSNs side by side</h1>
  <p class="lede">Enter up to three stock numbers. Each chart uses the same price scale, so heights compare directly.</p>

  <form class="viz-compare-form" id="compare-form" autocomplete="off" novalidate>
    <label>NSN 1<input type="text" name="nsn1" inputmode="numeric" placeholder="5331-01-123-4567" /></label>
    <label>NSN 2<input type="text" name="nsn2" inputmode="numeric" placeholder="5331-01-123-4567" /></label>
    <label>NSN 3<input type="text" name="nsn3" inputmode="numeric" placeholder="5331-01-123-4567" /></label>
    <button class="btn" type="submit">Compare</button>
  </form>
  <p class="gloss" id="compare-status" role="status" aria-live="polite"></p>
  <div id="compare-out"></div>
  <noscript><p class="gloss">The comparison needs JavaScript. Each item's own page shows the same price history.</p></noscript>

  <section>
    <h2 class="section-title">What the comparison shows</h2>
    <p class="gloss">
      For each National Stock Number you enter, the page draws the unit price the government paid on every purchase
      record we hold, oldest to newest, and puts the charts on one shared price scale. With each chart come the item
      name, the number of solicitations open for it now, the number of awards on record, and its competition coding:
      whether the part is coded for competition or for a named source.
    </p>
    <h2 class="section-title">When it helps</h2>
    <ul class="gloss">
      <li><strong>Similar parts, different prices.</strong> Two O-rings or two bolts that differ in one dimension or material often sell at very different prices. Seeing them together shows which one is worth quoting.</li>
      <li><strong>A part and its replacement.</strong> When one stock number replaces another, compare the old price history with the new one before you price a bid.</li>
      <li><strong>Choosing what to make.</strong> Compare a few parts from one class to see which is bought most often and which price has held steady.</li>
    </ul>
    <h2 class="section-title">How to enter a stock number</h2>
    <p class="gloss">
      Type the 13 digits with or without dashes, for example 5331-01-123-4567 or 5331011234567. An NSN is a four-digit
      supply class followed by a nine-digit item number; <a href="/guides/what-is-an-nsn/">What is an NSN?</a> explains
      each part. If you do not know the number, <a href="/catalog/">browse the catalog</a> by class or search by part
      name from any page. To check a long list at once, use the <a href="/lookup/">bulk lookup</a>.
    </p>
    <p class="gloss">
      Every price comes from a public government purchase record, and each item's own page links to that record.
      Where the figures come from is set out in the <a href="/methodology/">methodology</a>.
    </p>
  </section>
</BaseLayout>

<script>
  import '../scripts/compare';
</script>
