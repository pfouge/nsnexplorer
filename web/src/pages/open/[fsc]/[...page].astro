---
// open/[fsc].astro — open-demand browse for one Federal Supply Class. Mirrors
// fsc/[fsc].astro's product-grid + filter-rail pattern, but the filters are
// tuned for buying decisions on OPEN solicitations (closing window, quantity,
// competition, drawing) rather than historic purchase cadence.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SignupForm from '../../../components/SignupForm.astro';
import Pager from '../../../components/Pager.astro';
import { SITE_URL } from '../../../consts';
import { loadSiteData, formatDate } from '../../../lib/data';
import { buildSolicitationCards, fsgName, isPlaceholderFscName, UNLISTED_FSC_NAME, type ProductCard } from '../../../lib/browse';
import { PAGE_SIZE, pageCount, pageItems, pageNumbers, pageParam, pageRange, pageUrl, rangeLabel, pagedDescriptionPrefix, pagedTitle } from '../../../lib/paginate';
import { memo, release } from '../../../lib/paged-cache';
import { openDescription, openTitle } from '../../../lib/seo-copy';

// /open/<code>/ is page 1; /open/<code>/page/<n>/ holds the next PAGE_SIZE cards.
export async function getStaticPaths() {
  const data = await loadSiteData();
  // Every FSC with ANY solicitation on record (open or closed) — the
  // history browse, not just the currently-open board.
  return [...data.solicitationsByFsc.entries()].flatMap(([fsc, entry]) => {
    const total = buildSolicitationCards(data, fsc).length;
    const pages = pageCount(total);
    return pageNumbers(total).map((page) => ({
      params: { fsc, page: pageParam(page) },
      props: { fscCode: fsc, fscName: entry.name, page, pages },
    }));
  });
}

const { fscCode, fscName, page, pages } = Astro.props as {
  fscCode: string;
  fscName: string | null;
  page: number;
  pages: number;
};
const data = await loadSiteData();
// entry = OPEN-only solicitations in this FSC (for the "open now" stat
// strip); allEntry = every status (for the history signal line + filters).
const entry = data.openByFsc.get(fscCode);
const allEntry = data.solicitationsByFsc.get(fscCode);

const rawDisplayName = fscName ?? data.deepFscs.find((f) => f.fsc === fscCode)?.name ?? `FSC ${fscCode}`;
// Freshly-grown FSCs (from RFQ ingest) start out with a 'FSC NNNN'
// placeholder name (see ingest/dibbs/load.mjs) — don't pair it with itself
// in user-facing titles, e.g. "Open demand — FSC 7310 (FSC 7310)".
const hasRealFscName = !isPlaceholderFscName(fscCode, rawDisplayName);
const displayName = hasRealFscName ? rawDisplayName : UNLISTED_FSC_NAME;
const fsg = fscCode.slice(0, 2);
const departmentName = fsgName(fsg);

const cacheKey = `open:${fscCode}`;
const allCards: ProductCard[] = memo(cacheKey, () => buildSolicitationCards(data, fscCode));
if (page === pages) release(cacheKey);
// Cards are sorted open-first / closing-soonest (see buildSolicitationCards);
// each page renders PAGE_SIZE of them and the client merges the rest in on the
// first filter/sort interaction, so filters always span the whole category.
const cards: ProductCard[] = pageItems(allCards, page);
const baseUrl = `/open/${fscCode}/`;
const range = pageRange(allCards.length, page);
// Status-scope totals over the WHOLE category (first paint shows "Open now"),
// and how many cards of each scope sit on earlier pages (for "501–812 of 3,900").
const isOpenCard = (c: ProductCard) => c.openCount > 0;
const totalOpen = allCards.filter(isOpenCard).length;
const totals = { open: totalOpen, closed: allCards.length - totalOpen, all: allCards.length };
const before = allCards.slice(0, (page - 1) * PAGE_SIZE);
const beforeOpen = before.filter(isOpenCard).length;
const offsets = { open: beforeOpen, closed: before.length - beforeOpen, all: before.length };
const openOnPage = cards.filter(isOpenCard).length;
// First paint shows the default Status scope ("Open now").
const firstPaintCount = pages > 1
  ? openOnPage === 0
    ? '0'
    : rangeLabel(offsets.open + 1, offsets.open + openOnPage)
  : openOnPage.toLocaleString('en-US');

const fmtInt = (n: number) => n.toLocaleString('en-US');

// Category-level open stats, independent of the priced-catalog gate.
const solicitations = entry?.solicitations ?? [];
const closingSoonCutoff = new Date();
closingSoonCutoff.setUTCDate(closingSoonCutoff.getUTCDate() + 7);
const closingSoonHere = solicitations.filter(
  (s) => s.returnBy !== null && new Date(s.returnBy) <= closingSoonCutoff
).length;
const totalQtyHere = solicitations.reduce((sum, s) => sum + (s.quantity ?? 0), 0);

// Whole-history stats for this category (every status) — the "record" view.
const allSolicitationsHere = allEntry?.solicitations ?? [];
const closedCountHere = allSolicitationsHere.length - solicitations.length;

// Build-date baseline for the per-card "Open · closes in Nd" badge.
const now = new Date();
const todayMs = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
interface StatusBadge {
  text: string;
  cls: 'green' | 'amber' | '';
}
const openBadge = (nextCloseDate: string | null): StatusBadge => {
  if (!nextCloseDate) return { text: 'Open', cls: 'green' };
  const days = Math.ceil((new Date(`${nextCloseDate}T00:00:00Z`).getTime() - todayMs) / 86400000);
  if (days <= 2) return { text: days <= 0 ? 'Open · closes today' : `Open · closes in ${days}d`, cls: 'amber' };
  return { text: `Open · closes in ${days}d`, cls: 'green' };
};

// Neutral badge for closed cards — reuses the existing muted-badge look
// (empty color class, same as the "date unknown" badge on /open/) rather
// than introducing a new one.
const closedBadge = (lastSolicited: string | null): StatusBadge => ({
  text: lastSolicited ? `Closed · last ${formatDate(lastSolicited)}` : 'Closed',
  cls: '',
});

const copy = {
  code: fscCode,
  name: hasRealFscName ? displayName : null,
  openCount: solicitations.length,
  nsnCount: new Set(solicitations.map((x) => x.nsn)).size,
};
const title = pagedTitle(openTitle(copy), page, pages);
const description = openDescription(copy, pagedDescriptionPrefix(page, pages));
const canonicalUrl = `${SITE_URL}${pageUrl(baseUrl, page)}`;
const headLinks = [
  ...(page > 1 ? [{ rel: 'prev', href: `${SITE_URL}${pageUrl(baseUrl, page - 1)}` }] : []),
  ...(page < pages ? [{ rel: 'next', href: `${SITE_URL}${pageUrl(baseUrl, page + 1)}` }] : []),
];

// First 200 catalog NSN links of page 1 as an ItemList.
const itemList =
  page === 1
    ? (() => {
        const items = cards.filter((c) => c.hasCatalogPage).slice(0, 200).map((c) => ({ name: `NSN ${c.dashed}${c.itemName ? ` ${c.itemName}` : ''}`, url: `/nsn/${c.dashed}/` }));
        return items.length > 0 ? { name: `${displayName} (FSC ${fscCode}) open demand NSNs`, items } : undefined;
      })()
    : undefined;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Open demand', item: `${SITE_URL}/open/` },
    { '@type': 'ListItem', position: 3, name: displayName, item: `${SITE_URL}${baseUrl}` },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  pageType="CollectionPage"
  canonicalUrl={canonicalUrl}
  extraSchema={[breadcrumbSchema]}
  headLinks={headLinks}
  itemList={itemList}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › <a href="/open/">Open demand</a> › {displayName}
  </nav>

  <p class="eyebrow">Open demand <span class="x">×</span> {departmentName}</p>

  <header class="hero">
    <h1>{displayName} <span class="badge mono">FSC {fscCode}</span></h1>
    <p class="lede">
      Open solicitations in Federal Supply Class {fscCode} — real requests for quote a supplier can
      bid on today, linked to the official DIBBS record for each one — plus the ones we've already
      recorded as they closed. Nothing here gets deleted when it expires: this category's demand
      history grows every time an RFQ closes.
    </p>
  </header>

  <div class="stat-strip">
    <div class="stat">
      <div class="value up">{fmtInt(solicitations.length)}</div>
      <div class="label">Open solicitations</div>
    </div>
    <div class="stat">
      <div class="value">{fmtInt(closingSoonHere)}</div>
      <div class="label">Closing within 7 days</div>
    </div>
    <div class="stat">
      <div class="value">{fmtInt(totalQtyHere)}</div>
      <div class="label">Total open quantity</div>
    </div>
    <div class="stat">
      <div class="value">{fmtInt(allSolicitationsHere.length)}</div>
      <div class="label">Tracked all-time ({fmtInt(closedCountHere)} closed)</div>
    </div>
  </div>

  <section class="products-section">
    <h2 class="section-title">Open parts</h2>
    {allCards.length === 0 ? (
      <p class="gloss">No solicitations indexed for this category yet.</p>
    ) : (
      <div class="products-layout">
        <aside class="filter-rail" aria-label="Filter open demand">
          <div class="filter-group">
            <label class="filter-label" for="f-status">Status</label>
            <select id="f-status">
              <option value="open" selected>Open now</option>
              <option value="closed">Closed</option>
              <option value="all">All</option>
            </select>
          </div>

          <div class="filter-group">
            <label class="filter-label" for="f-closes">Closing within</label>
            <select id="f-closes">
              <option value="any">Any time</option>
              <option value="3">3 days</option>
              <option value="7">7 days</option>
              <option value="30">30 days</option>
            </select>
          </div>

          <div class="filter-group">
            <label class="filter-label" for="f-minqty">Min quantity</label>
            <select id="f-minqty">
              <option value="any">Any</option>
              <option value="100">100+</option>
              <option value="1000">1,000+</option>
              <option value="10000">10,000+</option>
            </select>
          </div>

          <div class="filter-group" role="radiogroup" aria-labelledby="f-competition-label">
            <span class="filter-label" id="f-competition-label">Competition</span>
            <label><input type="radio" name="f-competition" value="all" checked /> All</label>
            <label><input type="radio" name="f-competition" value="open" /> Open</label>
            <label><input type="radio" name="f-competition" value="restricted" /> Restricted</label>
          </div>

          <div class="filter-group">
            <label><input type="checkbox" id="f-hasdrawing" /> Has drawing</label>
          </div>

          <div class="filter-group">
            <label class="filter-label" for="f-sort">Sort</label>
            <select id="f-sort">
              <option value="closes">Closing soonest</option>
              <option value="qty">Highest quantity</option>
              <option value="name">Item name</option>
            </select>
          </div>

          <p class="filter-count" id="filter-count" aria-live="polite">{firstPaintCount} of {totalOpen.toLocaleString('en-US')} shown</p>
        </aside>

        <div
          class="product-grid"
          id="product-grid"
          data-page={page}
          data-pages={pages}
          data-base={baseUrl}
          data-total={allCards.length}
          data-total-open={totals.open}
          data-total-closed={totals.closed}
          data-total-all={totals.all}
          data-offset-open={offsets.open}
          data-offset-closed={offsets.closed}
          data-offset-all={offsets.all}
        >
          {cards.map((c) => {
            const badge = c.openCount > 0 ? openBadge(c.nextCloseDate) : closedBadge(c.lastSolicited);
            const externalAttrs = c.hasCatalogPage
              ? {}
              : { target: '_blank', rel: 'nofollow noopener' };
            return (
              <article
                class="product-card"
                data-key={c.dashed}
                data-closes={c.nextCloseDate ?? ''}
                data-qty={c.openQuantity ?? 0}
                data-competition={c.competition}
                data-hasdrawing={c.hasDrawing ? '1' : '0'}
                data-material={c.material ?? ''}
                data-itemname={(c.itemName ?? '').toLowerCase()}
                data-openct={c.openCount}
                data-closedct={c.closedCount}
                data-laststatus={c.lastStatus}
                data-lastsolicited={c.lastSolicited ?? ''}
              >
                <a class="product-thumb" href={c.href} aria-label={`View ${c.itemName ?? c.dashed}`} {...externalAttrs}>
                  {c.thumbnail ? (
                    <div class="thumb-svg" set:html={c.thumbnail} />
                  ) : (
                    <div class="thumb-placeholder" aria-hidden="true">∅</div>
                  )}
                </a>
                <div class="product-body">
                  <a class="product-nsn mono" href={c.href} {...externalAttrs}>{c.dashed}</a>
                  <h3 class="product-name">{c.itemName ?? 'Unnamed item'}</h3>
                  <div class="product-signals">
                    <span class={`badge ${badge.cls}`}>{badge.text}</span>
                    <span class="signal mono">{c.openQuantity !== null ? c.openQuantity.toLocaleString('en-US') : '—'} units</span>
                    {c.competition !== 'unknown' && (
                      <span class={`badge ${c.competition === 'open' ? 'green' : 'amber'}`}>
                        {c.competition === 'open' ? 'Open' : 'Restricted'}
                      </span>
                    )}
                  </div>
                  <p class="gloss" style="margin:0.35rem 0 0; font-size:0.78rem;">
                    {fmtInt(c.solicitationCount)} solicitation{c.solicitationCount === 1 ? '' : 's'}
                    {' '}({fmtInt(c.openCount)} open · {fmtInt(c.closedCount)} closed)
                  </p>
                </div>
              </article>
            );
          })}
        </div>
      </div>
      <Pager base={baseUrl} page={page} pages={pages} />
      <p class="gloss" id="empty-state" hidden>
        No items match these filters.
        <button type="button" class="btn btn-ghost" id="clear-filters">Clear filters</button>
      </p>
    )}
  </section>

  <script>
    import { createPagedLoader, rangeLabel, readPagedConfig } from '../../../lib/paged-client';

    const grid = document.getElementById('product-grid');
    const countEl = document.getElementById('filter-count');
    const statusSelect = document.getElementById('f-status');
    const closesSelect = document.getElementById('f-closes');
    const minQtySelect = document.getElementById('f-minqty');
    const hasDrawingCheckbox = document.getElementById('f-hasdrawing');
    const sortSelect = document.getElementById('f-sort');

    if (
      grid &&
      statusSelect instanceof HTMLSelectElement &&
      closesSelect instanceof HTMLSelectElement &&
      minQtySelect instanceof HTMLSelectElement &&
      hasDrawingCheckbox instanceof HTMLInputElement &&
      sortSelect instanceof HTMLSelectElement
    ) {
      const cards = Array.from(grid.querySelectorAll<HTMLElement>(':scope > .product-card'));
      const cfg = readPagedConfig(grid);
      const fmt = (n: number) => n.toLocaleString('en-US');
      const loader = createPagedLoader({ grid, cards, countEl, pager: document.getElementById('pager') });
      // Today (UTC) as of the viewer's clock; the page itself is static.
      const todayIso = () => new Date().toISOString().slice(0, 10);
      // A card is open only while it has open solicitations AND its closing
      // date (when known) is not before today; otherwise it counts as Closed.
      const isOpenCard = (el: HTMLElement, today: string) => {
        const closes = el.dataset.closes ?? '';
        return Number(el.dataset.openct ?? 0) > 0 && (closes === '' || closes >= today);
      };

      const apply = () => {
        const status = statusSelect.value; // 'open' | 'closed' | 'all'
        const checkedCompetition = document.querySelector('input[name="f-competition"]:checked');
        const competition = checkedCompetition instanceof HTMLInputElement ? checkedCompetition.value : 'all';
        const maxCloseDays = closesSelect.value === 'any' ? null : Number(closesSelect.value);
        const minQty = minQtySelect.value === 'any' ? null : Number(minQtySelect.value);
        const needsDrawing = hasDrawingCheckbox.checked;
        const today = todayIso();
        const todayMs = new Date(`${today}T00:00:00Z`).getTime();

        let visibleCount = 0;
        let scopeCount = 0;
        for (const card of cards) {
          const el = card as HTMLElement;
          const open = isOpenCard(el, today);
          // Cards in the current Status scope ('all' imposes no condition).
          if (status === 'open' && !open) { el.style.display = 'none'; continue; }
          if (status === 'closed' && open) { el.style.display = 'none'; continue; }
          scopeCount++;
          let visible = true;
          if (competition !== 'all' && el.dataset.competition !== competition) visible = false;
          if (visible && maxCloseDays !== null) {
            const closes = el.dataset.closes;
            if (!closes) {
              visible = false;
            } else {
              // Past-dated rows never match: require 0 <= daysUntil <= N.
              const daysUntil = (new Date(`${closes}T00:00:00Z`).getTime() - todayMs) / 86400000;
              if (daysUntil < 0 || daysUntil > maxCloseDays) visible = false;
            }
          }
          if (visible && minQty !== null && Number(el.dataset.qty ?? 0) < minQty) visible = false;
          if (visible && needsDrawing && el.dataset.hasdrawing !== '1') visible = false;
          el.style.display = visible ? '' : 'none';
          if (visible) visibleCount++;
        }
        if (!loader.complete && !loader.failed) {
          // Before the first interaction only this page is present: show the
          // card range within the Status scope, over the server-emitted total.
          const scope = status === 'closed' ? 'closed' : status === 'all' ? 'all' : 'open';
          const scopeTotal = Number(grid.dataset[scope === 'open' ? 'totalOpen' : scope === 'closed' ? 'totalClosed' : 'totalAll'] ?? 0);
          const offset = Number(grid.dataset[scope === 'open' ? 'offsetOpen' : scope === 'closed' ? 'offsetClosed' : 'offsetAll'] ?? 0);
          const first = visibleCount === 0 ? '0' : cfg.pages > 1 ? rangeLabel(offset + 1, offset + visibleCount) : fmt(visibleCount);
          loader.setCount(`${first} of ${fmt(scopeTotal)} shown`);
        } else {
          loader.setCount(`${fmt(visibleCount)} of ${fmt(scopeCount)} shown`);
        }
        const emptyEl = document.getElementById('empty-state');
        if (emptyEl) emptyEl.hidden = visibleCount !== 0;
      };

      const clearFilters = () => {
        statusSelect.value = 'open';
        closesSelect.value = 'any';
        minQtySelect.value = 'any';
        document.querySelectorAll('input[name="f-competition"]').forEach((el) => {
          if (el instanceof HTMLInputElement) el.checked = el.value === 'all';
        });
        hasDrawingCheckbox.checked = false;
      };

      const sortCards = () => {
        const mode = sortSelect.value;
        const sorted = [...cards].sort((a, b) => {
          const ael = a as HTMLElement;
          const bel = b as HTMLElement;
          if (mode === 'qty') {
            return Number(bel.dataset.qty ?? 0) - Number(ael.dataset.qty ?? 0);
          }
          if (mode === 'name') {
            const an = ael.dataset.itemname ?? '';
            const bn = bel.dataset.itemname ?? '';
            // Unnamed items ("Unnamed item") sort last.
            if (an === '' || bn === '') return an === bn ? 0 : an === '' ? 1 : -1;
            return an.localeCompare(bn);
          }
          // 'closes': soonest first, unknown close dates sort last.
          const ac = ael.dataset.closes ?? '';
          const bc = bel.dataset.closes ?? '';
          if (ac === '' && bc === '') return 0;
          if (ac === '') return 1;
          if (bc === '') return -1;
          return ac.localeCompare(bc);
        });
        for (const card of sorted) grid.appendChild(card);
      };

      document.getElementById('clear-filters')?.addEventListener('click', () => {
        clearFilters();
        refresh();
      });

      // Sort runs over the whole `cards` array (server order, stable ties). The
      // DOM is only reordered when the selected sort differs from the last one applied.
      const defaultSort = Array.from(sortSelect.options).find((o) => o.defaultSelected)?.value ?? sortSelect.options[0].value;
      let appliedSort = defaultSort;
      const refresh = () => {
        if (sortSelect.value !== appliedSort) {
          sortCards();
          appliedSort = sortSelect.value;
        }
        apply();
      };
      // First interaction: pull in the other pages, then filter/sort the full category.
      const schedule = () => {
        if (loader.complete || loader.failed) refresh();
        else void loader.ensureAll().then(refresh);
      };
      statusSelect.addEventListener('change', schedule);
      document.querySelectorAll('input[name="f-competition"]').forEach((el) => el.addEventListener('change', schedule));
      closesSelect.addEventListener('change', schedule);
      minQtySelect.addEventListener('change', schedule);
      hasDrawingCheckbox.addEventListener('change', schedule);
      sortSelect.addEventListener('change', schedule);

      apply();
    }
  </script>

  <SignupForm
    hook="shop_alerts"
    fscInterest={fscCode}
    title="Alert me when new solicitations open in this category"
    description={`Get an email when a new RFQ opens for competition in ${displayName}.`}
    cta="Sign up"
  />
</BaseLayout>
