---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../consts';
import { loadSiteData, solicitationLinkLabel } from '../../lib/data';
import { buildDepartments, fscDisplayName, isBareGroup, isPlaceholderFscName, type DepartmentGroup } from '../../lib/browse';
import { fscLabel, groupDescription, groupIntro, groupTitle, listedFscName } from '../../lib/seo-copy';
import { closesLabel, daysUntil, serviceCategoryName } from '../../lib/services';

export async function getStaticPaths() {
  const data = await loadSiteData();
  const departments = buildDepartments(data);
  return departments.map((department) => ({
    params: { fsg: department.fsg },
    props: { department },
  }));
}

const { department } = Astro.props as { department: DepartmentGroup };
const data = await loadSiteData();

const fmtInt = (n: number) => n.toLocaleString('en-US');
const categoryCount = (fsc: string) => data.nsnsByFsc.get(fsc)?.length ?? 0;

// Open SAM.gov service notices tied to equipment in this group (closing soonest first).
const serviceNotices = data.serviceNoticesByFsg.get(department.fsg) ?? [];
const shownNotices = serviceNotices.slice(0, 10);
const now = new Date();
const todayMs = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());

// Classes in this group with their NSN and open-solicitation counts, largest first.
const openCount = (fsc: string) => data.openByFsc.get(fsc)?.solicitations.length ?? 0;
const classRows = department.fscs
  .map((f) => ({
    fsc: f.fsc,
    label: isPlaceholderFscName(f.fsc, f.name) ? `FSC ${f.fsc}` : f.name,
    nsnCount: categoryCount(f.fsc),
    open: openCount(f.fsc),
  }))
  .sort((a, b) => b.nsnCount - a.nsnCount || a.fsc.localeCompare(b.fsc));
const groupOpen = classRows.reduce((sum, r) => sum + r.open, 0);
const copy = { fsg: department.fsg, name: department.name, classCount: department.fscs.length, nsnCount: department.nsnCount };
const title = groupTitle(copy);
const description = groupDescription(copy);
const intro = groupIntro({ ...copy, topClasses: classRows.slice(0, 3).map((r) => ({ label: r.label, nsnCount: r.nsnCount })), openCount: groupOpen });
const itemList = {
  name: `${department.name} (FSG ${department.fsg}) supply classes`,
  items: department.fscs.map((f) => ({ name: fscLabel(f.fsc, listedFscName(f.fsc, f.name)), url: `/fsc/${f.fsc}/` })),
};
const canonicalUrl = `${SITE_URL}/group/${department.fsg}/`;

// A group the handbook has no title for, or with only a handful of tracked parts, has nothing
// of its own to say: it stays reachable from the catalog but is kept out of search indexes and
// the sitemap, and never carries the ad tag (noindex pages never do).
const bare = isBareGroup(department);
// Classes with open solicitations, most first, for the "Open demand" section.
const openRows = classRows.filter((r) => r.open > 0).sort((a, b) => b.open - a.open || a.fsc.localeCompare(b.fsc));
const namedClasses = department.fscs.filter((f) => !isPlaceholderFscName(f.fsc, f.name));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Catalog', item: `${SITE_URL}/catalog/` },
    { '@type': 'ListItem', position: 3, name: department.name, item: canonicalUrl },
  ],
};
---

<BaseLayout
  ads={!bare && department.fscs.length > 0}
  noindex={bare ? 'follow' : undefined}
  title={title}
  description={description}
  pageType="CollectionPage"
  canonicalUrl={canonicalUrl}
  extraSchema={[breadcrumbSchema]}
  itemList={itemList}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › <a href="/catalog/">Catalog</a> › {department.name}
  </nav>

  <p class="eyebrow">Department <span class="x">×</span> FSG {department.fsg}</p>

  <header class="hero">
    <h1>{department.name}</h1>
    <p class="lede">{intro}</p>
  </header>

  <div class="stat-strip">
    <div class="stat">
      <div class="value">{department.fscs.length.toLocaleString('en-US')}</div>
      <div class="label">Categories</div>
    </div>
    <div class="stat">
      <div class="value up">{fmtInt(department.nsnCount)}</div>
      <div class="label">NSNs tracked</div>
    </div>
  </div>

  <section>
    <h2 class="section-title">Categories</h2>
    {department.fscs.length === 0 ? (
      <p class="gloss">No categories are indexed yet in this department.</p>
    ) : (
      <div class="dept-grid">
        {department.fscs.map((fsc) => (
          <a class="dept-card card" href={`/fsc/${fsc.fsc}/`}>
            <div class="dept-code mono">FSC {fsc.fsc}</div>
            <h3>{fscDisplayName(fsc.fsc, fsc.name)}</h3>
            <p>{fmtInt(categoryCount(fsc.fsc))} NSNs tracked</p>
            {openCount(fsc.fsc) > 0 && <p>{fmtInt(openCount(fsc.fsc))} open {openCount(fsc.fsc) === 1 ? 'solicitation' : 'solicitations'}</p>}
          </a>
        ))}
      </div>
    )}
  </section>

  {!bare && (
    <section>
      <h2 class="section-title">What Federal Supply Group {department.fsg} covers</h2>
      <p class="gloss">
        The Federal Supply Classification sorts every item the government stocks into two-digit groups, and each
        group into four-digit supply classes. Group {department.fsg}, {department.name}, has
        {' '}{fmtInt(department.fscs.length)} {department.fscs.length === 1 ? 'class' : 'classes'} with parts on this site{namedClasses.length > 0 && ': '}
        {namedClasses.map((f, i) => (
          <>{i > 0 && (i === namedClasses.length - 1 ? ' and ' : ', ')}<a href={`/fsc/${f.fsc}/`}>{f.name}</a> (FSC {f.fsc})</>
        ))}.
        The first two digits of a National Stock Number are its group and the first four are its class, so every
        NSN that starts with {department.fsg} belongs here.
      </p>
      <p class="gloss">
        A class page lists the parts in that class that the government has bought or asked for, with the price
        paid on each purchase record, the competition coding (whether the buy is open to any qualified source or
        limited to approved ones), the suppliers that won awards, and the solicitations open now.
      </p>
    </section>
  )}

  {!bare && (
    <section>
      <h2 class="section-title">Open demand in this group</h2>
      {openRows.length === 0 ? (
        <p class="gloss">
          No solicitation is open in this group today. Solicitations are read from DIBBS and SAM.gov every day; the
          <a href="/open/">open demand board</a> shows what is open across every class.
        </p>
      ) : (
        <>
          <p class="gloss">
            {fmtInt(groupOpen)} {groupOpen === 1 ? 'solicitation is' : 'solicitations are'} open in
            {' '}{fmtInt(openRows.length)} {openRows.length === 1 ? 'class' : 'classes'} of this group today, read from
            DIBBS (the Defense Logistics Agency's bid board) and SAM.gov. Each link opens the list for that class,
            with the return-by date, quantity and last price paid for every part.
          </p>
          <ul class="gloss">
            {openRows.slice(0, 12).map((r) => (
              <li><a href={`/open/${r.fsc}/`}>{r.label}</a> (FSC {r.fsc}): {fmtInt(r.open)} open, {fmtInt(r.nsnCount)} parts tracked</li>
            ))}
          </ul>
        </>
      )}
    </section>
  )}

  {!bare && (
    <section>
      <h2 class="section-title">How suppliers use this page</h2>
      <ul class="gloss">
        <li><strong>Find the class you make parts for.</strong> Pick the class above that matches your product, then filter its parts by open bids, price history or drawing.</li>
        <li><strong>Check who wins today.</strong> Each class page names the suppliers with recent awards and what was paid, from the public award record.</li>
        <li><strong>Read the bid before you quote.</strong> A solicitation page shows the quantity, the return-by date, earlier prices for the same part and where the official documents are.</li>
      </ul>
      <p class="gloss">
        New to federal parts work? Start with <a href="/guides/federal-supply-class-fsc/">what a Federal Supply Class is</a>,
        <a href="/guides/what-is-an-nsn/">what an NSN is</a> and <a href="/guides/how-to-bid-on-dibbs/">how to bid on DIBBS</a>.
      </p>
    </section>
  )}

  {serviceNotices.length > 0 && (
    <section>
      <h2 class="section-title">Service and repair notices for this group</h2>
      <p class="gloss">
        Open SAM.gov notices for testing, repair, modification, installation or rental of equipment in this group.
      </p>
      <div class="table-wrap">
        <table class="rows-fold">
          <thead>
            <tr>
              <th>Notice</th>
              <th>Category</th>
              <th>Agency</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {shownNotices.map((n) => {
              const label = closesLabel(daysUntil(n.closesOn, todayMs));
              return (
                <tr>
                  <td style="white-space:normal; min-width:16rem;">{n.title ?? 'Untitled notice'}</td>
                  <td style="white-space:normal;">{serviceCategoryName(n.category)}</td>
                  <td style="white-space:normal;">{n.agency ?? '—'}</td>
                  <td>
                    <span class:list={['badge', label.cls]}>{label.text}</span>
                  </td>
                  <td><a href={n.sourceUrl} target="_blank" rel="nofollow noopener">{solicitationLinkLabel('sam_gov')}</a></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      {serviceNotices.length > 10 && (
        <p class="gloss">All {fmtInt(serviceNotices.length)} in <a href="/services/">Services</a></p>
      )}
    </section>
  )}
</BaseLayout>
