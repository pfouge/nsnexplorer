---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NsnPriceHistory from '../../components/viz/NsnPriceHistory.astro';
import NsnPriceByQty from '../../components/viz/NsnPriceByQty.astro';
import NsnAwardCalculator from '../../components/viz/NsnAwardCalculator.astro';
import NsnBuyingRhythm from '../../components/viz/NsnBuyingRhythm.astro';
import NsnTimeToAward from '../../components/viz/NsnTimeToAward.astro';
import NsnWhoWins from '../../components/viz/NsnWhoWins.astro';
import SignupForm from '../../components/SignupForm.astro';
import Follow from '../../components/Follow.astro';
import BidCalculator from '../../components/BidCalculator.astro';
import CiteThis from '../../components/CiteThis.astro';
import StandardDrawings from '../../components/StandardDrawings.astro';
import { SITE_URL } from '../../consts';
import { buildDiagram } from '../../lib/diagram';
import { ASSIST_QUICK_SEARCH_URL, collectStandardDocs, extractStandardRefs } from '../../lib/standard-refs';
import { DRAWINGS_ANCHOR, techDocsLineForPart } from '../../lib/drawings-copy';
import {
  toDashedNsn,
  undashNsn,
  withSpikeRatios,
  computeNsnPriceStats,
  formatDate,
  formatUsd,
  formatUsdPrecise,
  amscGloss,
  amcGloss,
  competitionOf,
  competitionSentence,
  COMPETITION_BADGE,
  solicitationLinkLabel,
  parseCharacteristics,
} from '../../lib/shared';
import { loadNsnPage, openSql } from '../../lib/nsn-page';
import { databaseUrlFrom } from '../../lib/runtime-env';
import { nsnCopyInputFrom } from '../../lib/nsn-copy';
import { nsnDescription, nsnSummary, nsnTitle } from '../../lib/seo-copy';
import { MIN_POINTS_CALC, calcRows } from '../../lib/viz-nsn-calc';
import { buildPriceHistory } from '../../lib/viz-nsn-price';
import { nsnEmbedPath } from '../../lib/embed';
import { buildPriceByQty } from '../../lib/viz-nsn-qty';
import { buildBuyingRhythm, type AwardEvent } from '../../lib/viz-nsn-rhythm';
import { buildTimeToAward } from '../../lib/viz-nsn-timing';
import { buildWinners, type WinAward } from '../../lib/viz-nsn-winners';
import { supplierLabel } from '../../lib/viz-nsn-common';
import { solicitationPath, supplierPath } from '../../lib/entity';
import { priceSummary, valueAtLastPrice } from '../../lib/sol-history';
import { competitionRead } from '../../lib/competition-read';
import { CEILING_LABEL, ceilingAmountText } from '../../lib/contract-ceiling';
import { NO_DEFINITION, alsoCalled, catalogCells, foreignSummary, moeView } from '../../lib/nsn-flis';
import { PRICE_EXPLAINER, SHELF_LIFE_SOURCE_LABEL, SHELF_LIFE_SOURCE_URL, calculatorReference, mgmtView } from '../../lib/nsn-mgmt';

// Rendered ON REQUEST by the Cloudflare Pages Function, not at build time.
// Cloudflare Pages caps a deployment at 20,000 files and the catalog is far
// larger, so every /nsn/ URL is served from one server route that reads the
// single NSN from Postgres (through the Hyperdrive binding) and is cached at
// the edge for an hour. Same URLs and HTML as the old static pages.
export const prerender = false;

const dashedParam = Astro.params.nsn ?? '';
const nsnCode = undashNsn(dashedParam);
// Canonical form is dashed; redirect bare 13-digit URLs so there is one URL.
if (/^\d{13}$/.test(dashedParam)) {
  return Astro.redirect(`/nsn/${toDashedNsn(dashedParam)}/`, 301);
}

const databaseUrl = databaseUrlFrom(Astro);
if (!databaseUrl) {
  return new Response('Database is not configured for this environment.', { status: 503 });
}
const sql = openSql(databaseUrl);
let page;
try {
  page = await loadNsnPage(sql, nsnCode);
} finally {
  await sql.end({ timeout: 1 }).catch(() => {});
}
if (!page) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=300');
  return new Response(null, { status: 404 });
}
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400');

const { nsn, fsc, partNumbers, contractActions } = page;
// Long-term contract base awards (lib/contract-ceiling.ts) carry a ceiling, not a price or a purchase:
// they stay in the lists and the win record, and are left out of every price, count and dollar figure.
const allPricePoints = page.pricePoints;
const rawPoints = allPricePoints.filter((p) => !p.isCeiling);
const purchaseActions = contractActions.filter((c) => !c.isCeiling);
const agencySlugById = new Map(page.agencies.map((a) => [a.agencyId, a.slug]));
const allSols = page.solicitations;

const dashed = toDashedNsn(nsn.nsn);
const points = withSpikeRatios(rawPoints);
const sortedPoints = [...points].sort((a, b) => b.awardedOn.localeCompare(a.awardedOn));
const stats = computeNsnPriceStats(rawPoints);

// Verdict strip: the five numbers a supplier needs first. Combines priced
// purchases (unit prices) and contract actions (award totals).
const allDates = [
  ...rawPoints.map((p) => p.awardedOn),
  ...purchaseActions.map((c) => c.actionDate).filter((d): d is string => d !== null),
].sort();
const lastPurchased = allDates.at(-1) ?? null;
const firstPurchased = allDates[0] ?? null;
const recordCount = rawPoints.length + purchaseActions.length;
const spanYears =
  firstPurchased && lastPurchased
    ? Math.max(1, (new Date(lastPurchased).getTime() - new Date(firstPurchased).getTime()) / 31557600000)
    : 1;
const perYear = recordCount / spanYears;
const totalDemandDollars =
  rawPoints.reduce((s, p) => s + (p.totalValue ?? p.unitPrice * (p.quantity ?? 1)), 0) +
  purchaseActions.reduce((s, c) => s + (c.obligation ?? 0), 0);
const latestPoint = [...rawPoints].sort((a, b) => a.awardedOn.localeCompare(b.awardedOn)).at(-1);
const latestAction = [...purchaseActions]
  .filter((c) => c.actionDate !== null)
  .sort((a, b) => a.actionDate!.localeCompare(b.actionDate!))
  .at(-1);
// AMSC G/Z and AMC 1/2 indicate competitive acquisition; others lean
// restricted. Unknown stays neutral.
const competition = competitionOf(nsn.amc, nsn.amsc);
const competitionOpen = competition === 'open';
const dibbsRfqUrl = `https://www.dibbs.bsm.dla.mil/RFQ/RFQNsn.aspx?value=${nsn.nsn}&category=nsn`;
const dibbsAwardUrl = `https://www.dibbs.bsm.dla.mil/Awards/AwdRecs.aspx?category=awdnsn&TypeSrch=cq&Value=${nsn.nsn}`;

// Solicitation history for this NSN: EVERY solicitation on record (open or
// closed), newest first — every solicitation on record for this NSN
// and is never pruned, so this is the NSN's growing demand record.
// Open-demand read: just the currently-open subset, closing soonest first.
const openSols = allSols
  .filter((s) => s.status === 'open')
  .sort((a, b) => {
    if (a.returnBy === b.returnBy) return 0;
    if (a.returnBy === null) return 1;
    if (b.returnBy === null) return -1;
    return a.returnBy.localeCompare(b.returnBy);
  });
// Set-aside(s) declared on any currently-open solicitation — surfaced in the
// "Can you win it?" eligibility block alongside AMSC/AMC.
const openSetAsides = [...new Set(openSols.map((s) => s.setaside).filter((v): v is string => !!v))];
const openNow = new Date();
const openTodayMs = Date.UTC(openNow.getUTCFullYear(), openNow.getUTCMonth(), openNow.getUTCDate());
interface OpenSolBadge {
  text: string;
  cls: 'green' | 'amber';
}
const openSolBadge = (returnBy: string | null): OpenSolBadge => {
  if (!returnBy) return { text: 'Open', cls: 'green' };
  const days = Math.ceil((new Date(`${returnBy}T00:00:00Z`).getTime() - openTodayMs) / 86400000);
  if (days <= 2) return { text: days <= 0 ? 'Closes today' : `Closes in ${days}d`, cls: 'amber' };
  return { text: `Closes in ${days}d`, cls: 'green' };
};

// Status badge for the full solicitation history table below — 'open' reads
// green (like the rest of the site's open-competition badges), every closed
// status (expired/cancelled/awarded/unknown) reads muted/neutral.
interface HistoryStatusBadge {
  text: string;
  cls: 'green' | '';
}
const historyStatusBadge = (status: string): HistoryStatusBadge => {
  if (status === 'open') return { text: 'Open', cls: 'green' };
  return { text: status.charAt(0).toUpperCase() + status.slice(1), cls: '' };
};

// Product identity: FLIS characteristics + manufacturer part numbers.
const characteristics = parseCharacteristics(nsn.characteristics);

// FLIS catalog record (identification codes, related items, replaced stock numbers, MOE rules).
const flis = page.flis;
const catalog = catalogCells(flis.identification);
const alsoLine = alsoCalled(flis);
const fieldDefs = (flis.identification?.fieldDefinitions ?? []).filter((d) => d.text);
const hasCatalog = catalog.length > 0 || alsoLine !== null;
const moe = moeView(flis.moeRules);
const moeForeign = foreignSummary(moe);
const hasMoe = moe.us.length > 0 || moeForeign !== null;
// Standard drawings: MS/AN/NAS sheets, MIL and federal specs, and industry standards named in this part's part numbers
// and FLIS characteristics (lib/standard-refs.ts). Government documents link to ASSIST Quick Search, industry
// standards name the publisher that sells them. No query-string deep link into ASSIST is documented by DLA, so the
// link goes to the site and the id to type is shown beside it.
const standardDocs = collectStandardDocs({ characteristics, partNumbers });
const specDoc = (text: string): string | null => extractStandardRefs(text)[0]?.id ?? null;
const techDocsLine = techDocsLineForPart(openSols);

// Dimensioned drawing: generated at build time from catalog dimensions for
// every NSN whose specs support a known archetype (dispatched by FSC in
// buildDiagram). Returns null — section omitted — when there's no archetype
// for the FSC or the specs lack the needed geometry.
const diagram = buildDiagram(characteristics, nsn.fsc, { nsnDashed: dashed, itemName: nsn.itemName });
const hasSpecs = Boolean(diagram) || standardDocs.length > 0 || characteristics.length > 0 || partNumbers.length > 0 || hasCatalog || flis.related.length > 0 || flis.cancellations.length > 0;

const lastUpdated = [...allPricePoints.map((p) => p.ingestedAt), ...contractActions.map((c) => c.ingestedAt)]
  .sort()
  .at(-1);

const itemLabel = nsn.itemName ?? dashed;
// Query-led copy: shared with the .md route (lib/nsn-copy.ts + lib/seo-copy.ts).
const copyInput = nsnCopyInputFrom(page);
const title = nsnTitle(copyInput);
const description = nsnDescription(copyInput);
const summary = nsnSummary(copyInput);

const canonicalUrl = `${SITE_URL}/nsn/${dashed}/`;
// This page is rendered on request, so "data as of" is the request date.
const citeAsOf = new Date().toISOString().slice(0, 10);
// The price history's Embed control.
const priceEmbed = {
  src: `${SITE_URL}${nsnEmbedPath(dashed)}`,
  pageUrl: canonicalUrl,
  title: `${dashed} ${nsn.itemName ?? ''} price history, NSN Explorer`.replace(/\s+/g, ' '),
};

// Charts: each builder returns null below its minimum, and a null chart (or a
// section with no charts) renders nothing. Flagged awards use the same
// withSpikeRatios() result as the highlighted rows in the purchase table.
const todayIso = new Date().toISOString().slice(0, 10);
const priceHistory = buildPriceHistory(points, todayIso);
const priceByQty = buildPriceByQty(points, allSols);
const calcData = points.length >= MIN_POINTS_CALC ? calcRows(points) : [];
const hasPriceCharts = priceHistory !== null || priceByQty !== null || calcData.length >= MIN_POINTS_CALC;
// Awards for the demand charts: price points, else the item's contract actions.
const datedActions = contractActions.filter((c): c is typeof c & { actionDate: string } => c.actionDate !== null);
const datedPurchaseActions = datedActions.filter((c) => !c.isCeiling);
// Buying rhythm counts purchases, so it skips long-term contract base awards.
const awardEvents: AwardEvent[] =
  points.length > 0
    ? points.map((p) => ({ date: p.awardedOn, quantity: p.quantity, supplier: supplierLabel(p.supplierName, p.cage), solNumber: p.solNumber }))
    : datedPurchaseActions.map((c) => ({ date: c.actionDate, quantity: null, supplier: supplierLabel(c.recipientName, c.cage), solNumber: null }));
// Who won counts every award on record, a long-term contract base award included: it is a real win.
const winAwards: WinAward[] =
  allPricePoints.length > 0
    ? allPricePoints.map((p) => ({ date: p.awardedOn, cage: p.cage, name: p.supplierName }))
    : datedActions.map((c) => ({ date: c.actionDate, cage: c.cage, name: c.recipientName }));
const rhythm = buildBuyingRhythm(allSols, awardEvents, todayIso);
const timing = buildTimeToAward(allPricePoints, allSols);
const winners = buildWinners(
  winAwards,
  partNumbers.filter((pn) => pn.cage).map((pn) => ({ cage: pn.cage!, name: pn.supplierName })),
  todayIso
);
const hasDemandCharts = rhythm !== null || timing !== null || winners !== null;

// Price headline: newest positive price (the same rule priceSummary uses; sortedPoints
// is newest first and stable, so ties keep the loader's order).
const headlineSummary = priceSummary(points);
const headlinePoint = sortedPoints.find((p) => Number.isFinite(p.unitPrice) && p.unitPrice > 0) ?? null;
const lastPrice = headlineSummary?.latest ?? null;
const openQtyTotal = openSols.reduce((sum, s) => sum + (s.quantity !== null && s.quantity > 0 ? s.quantity : 0), 0);
const openUnits = [...new Set(openSols.map((s) => s.unitOfIssue).filter((u): u is string => !!u))];
// Government supply record (PUB LOG management data): standard unit price, shelf life, source of supply, per-service rows.
// The newest positive award price (the price headline) is what the standard price is compared with.
const mgmt = mgmtView(flis.management, headlinePoint ? { price: headlinePoint.unitPrice, awardedOn: headlinePoint.awardedOn } : null);
const standardRef = calculatorReference(flis.management);
const openValueAtLastPrice = valueAtLastPrice(openQtyTotal, lastPrice);
const solValueAtLastPrice = (qty: number | null): number | null => valueAtLastPrice(qty, lastPrice);

// Competition read: last 10 awards with a supplier (price points, else dated contract actions).
const compRead = competitionRead({ coded: competition, awards: winAwards.map((a) => ({ cage: a.cage, date: a.date })) });
const streakName = compRead.streakCage ? (winAwards.find((a) => a.cage === compRead.streakCage && a.name)?.name ?? null) : null;
const listedSources = new Set(partNumbers.map((pn) => (pn.cage ?? '').trim()).filter((c) => c !== '')).size;
const readBadgeClass = compRead.tone === 'neutral' ? 'badge' : `badge ${compRead.tone}`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    ...(fsc
      ? [{ '@type': 'ListItem', position: 2, name: `FSC ${fsc.fsc}`, item: `${SITE_URL}/fsc/${fsc.fsc}/` }]
      : []),
    { '@type': 'ListItem', position: fsc ? 3 : 2, name: `NSN ${dashed}`, item: canonicalUrl },
  ],
};

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Price history for NSN ${dashed}`,
  description,
  url: canonicalUrl,
  publisher: { '@id': `${SITE_URL}/#org` },
  isAccessibleForFree: true,
  license: 'https://www.usa.gov/government-works',
};
---

<BaseLayout
  title={title}
  description={description}
  pageType="ItemPage"
  ogImage={allSols.length > 0 || fsc ? `/og/class-${nsn.fsc}.png` : undefined}
  canonicalUrl={canonicalUrl}
  extraSchema={[breadcrumbSchema, datasetSchema]}
  headLinks={[{ rel: 'alternate', type: 'text/markdown', href: `${SITE_URL}/nsn/${dashed}.md` }]}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> ›
    {fsc ? <a href={`/fsc/${fsc.fsc}/`}>FSC {fsc.fsc}</a> : <span>FSC {nsn.fsc}</span>} ›
    NSN {dashed}
  </nav>

  <p class="eyebrow">FSC {fsc?.fsc ?? nsn.fsc} <span class="x">×</span> {nsn.itemName ?? 'NSN'}</p>

  <header class="hero">
    <h1>{itemLabel}</h1>
    <p class="ident">
      <span class="code">{dashed}</span>
      <button type="button" class="copy" onclick={`navigator.clipboard && navigator.clipboard.writeText('${dashed}')`} aria-label="Copy NSN">Copy</button>
      <span class="code">{nsn.nsn}</span>
      <span class="code">NIIN {nsn.nsn.slice(4)}</span>
      {fsc ? <a class="code" href={`/fsc/${fsc.fsc}/`}>FSC {fsc.fsc}</a> : <span class="code">FSC {nsn.fsc}</span>}
    </p>
    <p class="lede">{summary}</p>
    <Follow kind="nsn" entity={nsn.nsn} label={itemLabel} />
  </header>

  {headlineSummary && headlinePoint && (
    <div class="stat-strip roomy">
      <div class="stat">
        <div class="value up"><a href={headlinePoint.sourceUrl} target="_blank" rel="noopener noreferrer">{formatUsdPrecise(headlinePoint.unitPrice)}</a></div>
        <div class="label">Most recent price</div>
        <div class="gloss">Awarded {formatDate(headlinePoint.awardedOn)}</div>
      </div>
      {headlineSummary.n >= 2 && (
        <div class="stat">
          <div class="value">{formatUsdPrecise(headlineSummary.low)} – {formatUsdPrecise(headlineSummary.high)}</div>
          <div class="label">Last {headlineSummary.n} awards</div>
        </div>
      )}
      {headlineSummary.n >= 2 && (
        <div class="stat">
          <div class="value">{formatUsdPrecise(headlineSummary.average)}</div>
          <div class="label">Average of last {headlineSummary.n}</div>
        </div>
      )}
      <div class="stat">
        <div class="value">{points.length.toLocaleString('en-US')}</div>
        <div class="label">Prices on record</div>
      </div>
      {openQtyTotal > 0 && (
        <div class="stat">
          <div class="value">{openSols.length.toLocaleString('en-US')} solicitation{openSols.length === 1 ? '' : 's'} · {openQtyTotal.toLocaleString('en-US')} unit{openQtyTotal === 1 ? '' : 's'}</div>
          <div class="label">Open now</div>
        </div>
      )}
      {openQtyTotal > 0 && openValueAtLastPrice !== null && (
        <div class="stat">
          <div class="value">≈ ${Math.round(openValueAtLastPrice).toLocaleString('en-US')}</div>
          <div class="label">Value at last price</div>
          <div class="gloss">Open quantity × last unit price</div>
        </div>
      )}
    </div>
  )}

  <nav class="tabs" aria-label="On this page">
    <a href="#open">Open bids <span class="tab-count">{openSols.length}</span></a>
    <a href="#competition">Competition</a>
    {(diagram || standardDocs.length > 0 || characteristics.length > 0 || partNumbers.length > 0) && <a href="#specs">Specs</a>}
    <a href="#prices">Prices <span class="tab-count">{points.length.toLocaleString('en-US')}</span></a>
    <a href="#purchases">Purchases</a>
    {(allSols.length > 0 || hasDemandCharts) && <a href="#demand">Demand{allSols.length > 0 && <> <span class="tab-count">{allSols.length.toLocaleString('en-US')}</span></>}</a>}
    <a href="#about">About</a>
  </nav>

  <!-- 1. Open for bid — the first question a supplier asks: is there a live RFQ to bid on? -->
  {openSols.length > 0 ? (
    <section class="panel open-panel" id="open">
      <h2 class="section-title" style="margin-top:0;">Open for bid</h2>
      <p class="gloss">
        {openSols.length} open solicitation{openSols.length === 1 ? '' : 's'} on record right now —
        quantity, close date, and where to submit.
      </p>
      <div class="table-wrap" style="border:0;">
        <table>
          <thead>
            <tr>
              <th>Solicitation</th>
              <th class="num">Qty</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {openSols.map((s) => {
              const badge = openSolBadge(s.returnBy);
              return (
                <tr>
                  <td class="mono">
                    {solicitationPath(s.solNumber) ? (
                      <a href={solicitationPath(s.solNumber)!}>{s.solNumber}</a>
                    ) : (
                      <a href={s.sourceUrl} target="_blank" rel="nofollow noopener">{s.solNumber}</a>
                    )}
                  </td>
                  <td class="num mono">
                    {s.quantity !== null ? s.quantity.toLocaleString('en-US') : '—'}
                    {solValueAtLastPrice(s.quantity) !== null && (
                      <div class="gloss">≈ ${Math.round(solValueAtLastPrice(s.quantity)!).toLocaleString('en-US')} at last price</div>
                    )}
                  </td>
                  <td><span class={`badge ${badge.cls}`}>{badge.text}</span></td>
                  <td><a href={s.sourceUrl} target="_blank" rel="nofollow noopener">Bid →</a></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      {techDocsLine && (
        <p class="gloss" id="open-tech-docs">
          {techDocsLine.text}{' '}
          <a href={`/solicitation/${techDocsLine.solNumber}/#${DRAWINGS_ANCHOR}`}>How to get the drawings</a>
        </p>
      )}
    </section>
  ) : (
    <section class="panel" id="open">
      <h2 class="section-title" style="margin-top:0;">Open for bid</h2>
      <p class="gloss">No open solicitations on record for this NSN right now.</p>
      <p style="margin-top:1rem;">
        <a class="btn" href={dibbsRfqUrl} target="_blank" rel="nofollow noopener">
          Search open RFQs on DIBBS →
        </a>
      </p>
    </section>
  )}

  <!-- 2. Can you win it? — the acquisition method codes on record (DFARS PGI 217.7506). -->
  <section class="card" id="competition">
    <h2 class="section-title" style="margin-top:0;">Can you win it?</h2>
    <p style="margin:0 0 0.6rem;"><span class={readBadgeClass}>{compRead.label}</span> {compRead.reason}</p>
    <p class="gloss">{competitionSentence(nsn.amc, nsn.amsc)}</p>
    <div class="datastrip" style="margin-top:0.9rem;">
      <div class="cell">
        <div class="k">Acquisition method (AMC)</div>
        <div class="v">{nsn.amc ? <span class="badge">{nsn.amc}</span> : '—'}</div>
      </div>
      <div class="cell">
        <div class="k">Suffix (AMSC)</div>
        <div class="v">{nsn.amsc ? <span class="badge">{nsn.amsc}</span> : '—'}</div>
      </div>
      <div class="cell">
        <div class="k">Competition</div>
        <div class="v">
          {competition === 'unknown' ? (
            '—'
          ) : (
            <span class={`badge ${competitionOpen ? 'green' : 'amber'}`}>{COMPETITION_BADGE[competition]}</span>
          )}
        </div>
      </div>
      <div class="cell">
        <div class="k">Awards with a supplier (last 10)</div>
        <div class="v">{compRead.considered}</div>
      </div>
      <div class="cell">
        <div class="k">Distinct winners</div>
        <div class="v">{compRead.considered > 0 ? compRead.distinctWinners : '—'}</div>
      </div>
      <div class="cell">
        <div class="k">Current streak</div>
        <div class="v">
          {compRead.streak < 2 ? (
            '—'
          ) : (
            <>
              {compRead.streak} in a row
              {compRead.streakCage && (
                <span class="gloss" style="display:block; font-size:0.8125rem; font-weight:400; line-height:1.35;">{supplierPath(compRead.streakCage) ? <a href={supplierPath(compRead.streakCage)!}>{streakName ?? compRead.streakCage}</a> : (streakName ?? compRead.streakCage)}</span>
              )}
            </>
          )}
        </div>
      </div>
      <div class="cell">
        <div class="k">Listed sources</div>
        <div class="v">{listedSources}</div>
      </div>
    </div>
    {(nsn.amc || nsn.amsc) && (
      <p class="gloss" style="margin-top:0.9rem;">
        {[amcGloss(nsn.amc), amscGloss(nsn.amsc)].filter(Boolean).join(' ')}{' '}
        The codes describe the item's status on record, not any one solicitation.{' '}
        <a href="/guides/amc-amsc-codes/">What the codes mean</a>
      </p>
    )}
    {openSetAsides.length > 0 && (
      <p class="gloss" style="margin-top:0.6rem;">
        Set-aside on open solicitation{openSetAsides.length === 1 ? '' : 's'}: {openSetAsides.join(', ')}
      </p>
    )}
    {hasMoe && (
      <>
        <h3 class="section-title" style="margin-top:1.5rem;">Who manages it</h3>
        <p class="gloss">
          The services and agencies that hold a management record for this NSN, and how each says it buys it.
        </p>
        {moe.us.length > 0 && (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Service or agency</th>
                  <th>AMC</th>
                  <th>AMSC</th>
                  <th>Acquisition advice</th>
                  <th>Manager</th>
                  <th>Since</th>
                </tr>
              </thead>
              <tbody>
                {moe.us.map((r) => (
                  <tr>
                    <td>{r.service}</td>
                    <td>{r.amc ? <span class="badge" title={r.amcLabel ?? NO_DEFINITION}>{r.amc}</span> : '—'}</td>
                    <td>{r.amsc ? <span class="badge" title={r.amscLabel ?? NO_DEFINITION}>{r.amsc}</span> : '—'}</td>
                    <td>{r.aac ? (r.aacLabel ?? `${r.aac} (${NO_DEFINITION})`) : '—'}</td>
                    <td class="wrap">
                      {r.manager ?? '—'}
                      {r.retail && <span class="gloss" style="display:block; font-size:0.8125rem; line-height:1.35;">Retail: {r.retail}</span>}
                    </td>
                    <td class="mono">{r.since ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {moeForeign && (
          <details style="margin-top:0.75rem;">
            <summary class="gloss" style="cursor:pointer; margin-bottom:0.75rem;">{moeForeign}</summary>
            <p class="gloss">{[...moe.foreignNames, ...moe.otherNames].join(', ')}</p>
          </details>
        )}
      </>
    )}
    {mgmt.has && (
      <>
        <h3 class="section-title" id="supply-record" style="margin-top:1.5rem;">Government supply record</h3>
        {mgmt.price ? (
          <p class="gloss">{PRICE_EXPLAINER}</p>
        ) : (
          <p class="gloss">Supply-management data the federal catalog (DLA FLIS) holds for this NSN.</p>
        )}
        <div class="datastrip" style="margin-top:0.9rem;">
          {mgmt.priceLine && (
            <div class="cell">
              <div class="k">Government standard price</div>
              <div class="v">
                {mgmt.priceLine}
                <span class="gloss" style="display:block; font-size:0.8125rem; font-weight:400; line-height:1.35;">
                  Catalog price, not an award price{mgmt.effectiveLine ? `. Effective ${mgmt.effectiveLine}` : ''}
                </span>
              </div>
            </div>
          )}
          {mgmt.shelfParts && (
            <div class="cell">
              <div class="k">Shelf life</div>
              <div class="v">
                {mgmt.shelfParts.headline}
                {mgmt.shelfParts.note && <span class="gloss" style="display:block; font-size:0.8125rem; font-weight:400; line-height:1.35;">{mgmt.shelfParts.note}</span>}
              </div>
            </div>
          )}
          {mgmt.shelfMixed && (
            <div class="cell">
              <div class="k">Shelf life</div>
              <div class="v">Differs by service</div>
            </div>
          )}
          {mgmt.sosParts && (
            <div class="cell">
              <div class="k">Source of supply</div>
              <div class="v">
                <span class="badge mono">{mgmt.sosParts.code}</span>
                {mgmt.sosParts.meaning && <span class="gloss" style="display:block; font-size:0.8125rem; font-weight:400; line-height:1.35;">{mgmt.sosParts.meaning}</span>}
              </div>
            </div>
          )}
          {mgmt.sosMixed && (
            <div class="cell">
              <div class="k">Source of supply</div>
              <div class="v">Differs by service</div>
            </div>
          )}
        </div>
        {mgmt.compare && <p class="gloss" style="margin-top:0.9rem;">{mgmt.compare}</p>}
        {mgmt.table.length > 0 && (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Service or agency</th>
                  <th class="num">Unit price</th>
                  <th>Unit of issue</th>
                  <th>Shelf life</th>
                  <th>Source of supply</th>
                  <th>Acquisition advice</th>
                  <th>Effective</th>
                </tr>
              </thead>
              <tbody>
                {mgmt.table.map((r) => (
                  <tr>
                    <td>{r.scope}</td>
                    <td class="num mono">{r.price}</td>
                    <td>{r.ui}</td>
                    <td>{r.shelfLife}</td>
                    <td>{r.sos}</td>
                    <td>{r.aac}</td>
                    <td class="mono">{r.effective}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {mgmt.shelfParts !== null || mgmt.shelfMixed ? (
          <p class="gloss" style="margin-top:0.75rem;">
            Shelf life codes: <a href={SHELF_LIFE_SOURCE_URL} rel="noopener">{SHELF_LIFE_SOURCE_LABEL}</a>.
          </p>
        ) : null}
      </>
    )}
  </section>

  <!-- 3. What it is / can you make it — drawing, specs, and qualified part numbers together. -->
  {hasSpecs && (
    <section id="specs" style="margin-top:2.5rem;">
      <h2 class="section-title" style="margin-top:0;">What it is — can you make it?</h2>
      <p class="gloss">
        Dimensions, the FLIS specification requirements, and the manufacturer part numbers already
        qualified against this NSN.
      </p>
    </section>
  )}

  {hasCatalog && (
    <section>
      <h3 class="section-title">Catalog record</h3>
      <p class="gloss">
        Identification codes the federal catalog (DLA FLIS) holds for this NSN, each with its plain-language meaning.
      </p>
      {catalog.length > 0 && (
        <div class="datastrip" style="margin-top:0.9rem;">
          {catalog.map((c) => (
            <div class="cell">
              <div class="k">{c.label}</div>
              <div class="v">
                {c.key === 'assigned' ? c.value : c.key === 'scheduleB' ? <span class="badge mono">{c.value}</span> : <span class="badge">{c.value}</span>}
                {c.key !== 'assigned' && (
                  <span class="gloss" style="display:block; font-size:0.8125rem; font-weight:400; line-height:1.35;">{c.meaning ?? NO_DEFINITION}</span>
                )}
              </div>
            </div>
          ))}
        </div>
      )}
      {alsoLine && <p class="gloss" style="margin-top:0.9rem;">Also called: {alsoLine}</p>}
      {catalog.length > 0 && (
        <details>
          <summary class="gloss" style="cursor:pointer; margin-bottom:0.75rem;">What these codes mean</summary>
          {fieldDefs.length > 0 && (
            <dl class="gloss" style="margin:0 0 0.75rem;">
              {fieldDefs.map((d) => (
                <>
                  <dt style="font-weight:600; color:var(--ink);">{d.name ?? d.field}</dt>
                  <dd style="margin:0 0 0.5rem;">{d.text}</dd>
                </>
              ))}
            </dl>
          )}
          <p class="gloss">
            DEMIL, criticality and static/EMI sensitivity are not in the catalog's own dictionary; their code tables are on
            <a href="/guides/amc-amsc-codes/#catalog-codes"> the codes guide</a>.
          </p>
        </details>
      )}
    </section>
  )}

  {standardDocs.length > 0 && (
    <section id="standard-drawing">
      <h3 class="section-title" id="standard-drawing-h">Standard drawing</h3>
      <p class="gloss">
        This part is defined by a government standard or specification, and that document holds the real dimensioned
        drawing. Government documents are listed in ASSIST Quick Search, which needs no registration. Industry standards are
        sold by their publisher. We link to the official source and never host a copy.
      </p>
      <StandardDrawings docs={standardDocs} headingId="standard-drawing-h" />
    </section>
  )}

  {diagram && (
    <section>
      <h3 class="section-title">Dimensioned drawing</h3>
      <p class="gloss">
        Generated from the federal catalog's dimensional data for this NSN — reference only,
        not a manufacturing drawing.
      </p>
      <div class="card" style="padding:1rem;" set:html={diagram} />
    </section>
  )}

  {characteristics.length > 0 && (
    <section>
      <h3 class="section-title">Specifications</h3>
      <p class="gloss">
        From the federal catalog (DLA FLIS / PUB LOG) — what your part has to meet. Cited
        government specification documents can be searched by document number in <a href={ASSIST_QUICK_SEARCH_URL} target="_blank" rel="nofollow noopener">ASSIST Quick
        Search ↗</a>, DoD's public document search.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Requirement</th>
              <th>Value</th>
            </tr>
          </thead>
          <tbody>
            {characteristics.map((c) => {
              const doc = c.reply ? specDoc(c.reply) : null;
              return (
                <tr>
                  <td>
                    {c.requirement ?? c.mrc ?? '—'}
                    {c.requirement && c.mrc && (
                      <span class="mono gloss" style="font-size:0.75rem; margin-left:0.4rem;">{c.mrc}</span>
                    )}
                  </td>
                  <td>
                    {c.reply ?? '—'}
                    {doc && (
                      <span class="badge mono" style="margin-left:0.5rem; font-size:0.75rem;" title="Specification document — look up in ASSIST">{doc}</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {partNumbers.length > 0 && (
    <section>
      <h3 class="section-title">Manufacturer part numbers</h3>
      <p class="gloss">
        Commercial part numbers cross-referenced to this NSN in the federal catalog — the parts
        that have been accepted as satisfying this stock number, and who makes them.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Part number</th>
              <th>CAGE</th>
              <th>Manufacturer</th>
            </tr>
          </thead>
          <tbody>
            {partNumbers.map((pn) => (
              <tr>
                <td class="mono">{pn.partNumber}</td>
                <td class="mono">{pn.cage ?? '—'}</td>
                <td>{pn.supplierName ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {flis.related.length > 0 && (
    <section>
      <h3 class="section-title">Related items</h3>
      <p class="gloss">
        Other stock numbers the federal catalog links to this one, with the standardization status on record.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Related NSN</th>
              <th>Standardization status</th>
              <th>Decided</th>
            </tr>
          </thead>
          <tbody>
            {flis.related.map((r) => (
              <tr>
                <td class="mono">{r.hasPage ? <a href={`/nsn/${r.relatedNsn}/`}>{r.relatedNsn}</a> : r.relatedNsn}</td>
                <td>{r.iscLabel ?? (r.isc ? `Code ${r.isc}, ${NO_DEFINITION}` : '—')}</td>
                <td class="mono">{r.date ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {flis.relatedTotal > flis.related.length && (
        <p class="gloss">Showing {flis.related.length} of {flis.relatedTotal.toLocaleString('en-US')}.</p>
      )}
    </section>
  )}

  {flis.cancellations.length > 0 && (
    <section>
      <h3 class="section-title">Earlier stock numbers replaced by this one</h3>
      <p class="gloss">
        Older stock numbers the federal catalog cancelled in favour of this NSN, newest first. If you hold stock or an old
        requisition under one of them, this is the number to use now.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Earlier stock number</th>
              <th>Status of that number</th>
              <th>Effective</th>
            </tr>
          </thead>
          <tbody>
            {flis.cancellations.map((c) => (
              <tr>
                <td class="mono">{c.cancelledNsn}</td>
                <td>{c.statusLabel ?? (c.statusCode ? `Code ${c.statusCode}, ${NO_DEFINITION}` : '—')}</td>
                <td class="mono">{c.effectiveDate ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {flis.cancellationsTotal > flis.cancellations.length && (
        <p class="gloss">Showing {flis.cancellations.length} of {flis.cancellationsTotal.toLocaleString('en-US')}.</p>
      )}
    </section>
  )}

  <!-- 4. What it pays — so you can quote: the price/demand record, reframed as quoting intel. -->
  <section id="prices" style="margin-top:2.5rem;">
    <h2 class="section-title" style="margin-top:0;">What it pays — so you can quote</h2>
    <p class="gloss">
      The government's own price and demand record for this NSN — what past awards cleared at,
      so you know where to land your quote.
    </p>
    <BidCalculator
      context="nsn"
      quantity={openQtyTotal > 0 ? openQtyTotal : null}
      unitOfIssue={openUnits.length === 1 ? openUnits[0] : null}
      standard={standardRef}
      summary={headlineSummary}
      latestAwardedOn={headlinePoint?.awardedOn ?? null}
      latestSourceUrl={headlinePoint?.sourceUrl ?? null}
    />
  </section>

  <div class="datastrip" style="margin-top:0.5rem;">
    <div class="cell">
      <div class="k">Latest unit price</div>
      <div class="v up">{stats ? formatUsdPrecise(stats.latest) : '—'}</div>
    </div>
    <div class="cell">
      <div class="k">Purchases</div>
      <div class="v">{stats ? stats.count.toLocaleString('en-US') : '0'}</div>
    </div>
    <div class="cell">
      <div class="k">Total spend</div>
      <div class="v">{stats ? formatUsd(stats.totalSpend) : '—'}</div>
    </div>
  </div>

  <div class="stat-strip">
    <div class="stat">
      <div class="value">{lastPurchased ? formatDate(lastPurchased) : '—'}</div>
      <div class="label">Last purchased</div>
    </div>
    <div class="stat">
      <div class="value">{recordCount > 0 ? `${recordCount} · ${perYear.toFixed(1)}/yr` : '—'}</div>
      <div class="label">Purchase records</div>
    </div>
    <div class="stat">
      <div class="value up">{recordCount > 0 ? formatUsd(totalDemandDollars) : '—'}</div>
      <div class="label">Total demand</div>
    </div>
    <div class="stat">
      <div class="value">
        {latestPoint
          ? formatUsdPrecise(latestPoint.unitPrice)
          : latestAction?.obligation != null
            ? formatUsd(latestAction.obligation)
            : '—'}
      </div>
      <div class="label">{latestPoint ? 'Latest unit price' : 'Latest award total'}</div>
    </div>
  </div>

  <p class="gloss" style="margin-top:1.2rem;"><a href={`/compare/#${dashed}`}>Compare with other items</a></p>

  {hasPriceCharts && (
    <section style="margin-top:1rem;">
      {priceHistory && <NsnPriceHistory model={priceHistory} embed={priceEmbed} />}
      {priceByQty && <NsnPriceByQty model={priceByQty} />}
      {calcData.length >= MIN_POINTS_CALC && <NsnAwardCalculator rows={calcData} />}
    </section>
  )}

  <section id="purchases">
    <h3 class="section-title">Purchase history</h3>
    {sortedPoints.length === 0 ? (
      <p class="gloss">No priced purchases on record for this NSN yet.</p>
    ) : (
      <div class="table-wrap">
        <table>
          <caption>{sortedPoints.length} purchase{sortedPoints.length === 1 ? '' : 's'} on record</caption>
          <thead>
            <tr>
              <th>Awarded</th>
              <th class="num">Qty</th>
              <th class="num">Unit price</th>
              <th class="num">Total</th>
              <th>Supplier</th>
              <th>Agency</th>
              <th>Source</th>
            </tr>
          </thead>
          <tbody>
            {sortedPoints.map((p) => (
              <tr class:list={{ overcharge: p.spikeRatio !== null }}>
                <td class="mono">{formatDate(p.awardedOn)}</td>
                <td class="num mono">{p.quantity !== null ? p.quantity.toLocaleString('en-US') : '—'}</td>
                <td class="num price">
                  {formatUsdPrecise(p.unitPrice)}
                  {p.spikeRatio !== null && (
                    <span class="badge amber" style="margin-left:0.4rem;">{p.spikeRatio.toFixed(1)}× median</span>
                  )}
                </td>
                <td class="num mono">{p.totalValue !== null ? formatUsd(p.totalValue) : '—'}</td>
                <td>
                  {supplierPath(p.cage) ? <a href={supplierPath(p.cage)!}>{p.supplierName ?? 'Unknown'}</a> : (p.supplierName ?? 'Unknown')} {p.cage && <span class="cage">({p.cage})</span>}
                </td>
                <td>
                  {p.agencyId !== null && agencySlugById.has(p.agencyId) ? (
                    <a href={`/agency/${agencySlugById.get(p.agencyId)}/`}>{p.agencyName ?? 'Unknown'}</a>
                  ) : (
                    p.agencyName ?? 'Unknown'
                  )}
                </td>
                <td><a href={p.sourceUrl} target="_blank" rel="noopener noreferrer">Source ↗</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <section>
    <h3 class="section-title">Related contract actions</h3>
    <p class="gloss">
      Contract action totals, not unit prices — obligation amounts from USAspending for related
      awards, shown for context only. These do not appear on the price chart above.
      {contractActions.some((c) => c.isCeiling) && (
        <> A long-term contract shows the most it can be worth, not money spent. It is not counted in the purchase totals on this page.</>
      )}
    </p>
    {contractActions.length === 0 ? (
      <p class="gloss">No related contract actions on record.</p>
    ) : (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Action date</th>
              <th>Award #</th>
              <th>Recipient</th>
              <th>Agency</th>
              <th class="num">Obligation</th>
            </tr>
          </thead>
          <tbody>
            {contractActions.map((c) => (
              <tr>
                <td class="mono">{c.actionDate ? formatDate(c.actionDate) : '—'}</td>
                <td class="mono">
                  <a href={c.sourceUrl} target="_blank" rel="noopener noreferrer">{c.piid ?? 'record'} ↗</a>
                </td>
                <td>{c.recipientName ?? '—'}{c.isCeiling && <> <span class="badge">{CEILING_LABEL}</span></>}</td>
                <td>{c.agencyName ?? '—'}</td>
                <td class="num mono">{c.obligation === null ? '—' : c.isCeiling ? ceilingAmountText(formatUsd(c.obligation)) : formatUsd(c.obligation)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <!-- 5. Demand history — every solicitation on record, open and closed. -->
  {(allSols.length > 0 || hasDemandCharts) && (
    <section id="demand" style="margin-top:2.5rem;">
      <h2 class="section-title" style="margin-top:0;">Demand history</h2>
      {allSols.length > 0 && (
      <p class="gloss">
        Every solicitation we've indexed for this NSN, open and closed — {allSols.length} on record.
        Closed RFQs (expired, cancelled, or awarded) stay here as a record of past demand; they
        never get removed.
      </p>
      )}
      {rhythm && <NsnBuyingRhythm model={rhythm} />}
      {(timing || winners) && (
        <div class="viz-grid" style="margin-bottom:1.6rem;">
          {timing && <NsnTimeToAward model={timing} full={!winners} />}
          {winners && <NsnWhoWins model={winners} full={!timing} />}
        </div>
      )}
      {allSols.length > 0 && (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Solicitation</th>
              <th>Issued</th>
              <th>Closes / closed</th>
              <th class="num">Qty</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {allSols.map((s) => {
              const badge = historyStatusBadge(s.status);
              return (
                <tr>
                  <td class="mono">
                    {solicitationPath(s.solNumber) ? <a href={solicitationPath(s.solNumber)!}>{s.solNumber}</a> : s.solNumber}
                  </td>
                  <td class="mono">{s.issuedOn ? formatDate(s.issuedOn) : '—'}</td>
                  <td class="mono">{s.returnBy ? formatDate(s.returnBy) : '—'}</td>
                  <td class="num mono">{s.quantity !== null ? s.quantity.toLocaleString('en-US') : '—'}</td>
                  <td><span class={`badge ${badge.cls}`}>{badge.text}</span></td>
                  <td><a href={s.sourceUrl} target="_blank" rel="nofollow noopener">{solicitationLinkLabel(s.source)}</a></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      )}
    </section>
  )}

  <p style="margin:1rem 0 0; display:flex; gap:0.75rem; flex-wrap:wrap;">
    <a class="btn" href={dibbsRfqUrl} target="_blank" rel="nofollow noopener">
      Open RFQs on DIBBS →
    </a>
    <a class="btn btn-ghost" href={dibbsAwardUrl} target="_blank" rel="nofollow noopener">
      DIBBS award history ↗
    </a>
  </p>

  <SignupForm
    hook="shop_alerts"
    fscInterest={nsn.fsc}
    title="Alerts for parts like this are coming"
    description="Leave your email and we'll tell you when alerts for this supply class start. No emails until then."
    cta="Join the list"
  />

  <section class="card" id="about">
    <h2>About this data</h2>
    <ul class="gloss">
      <li>Unit prices: DLA DIBBS award records — every row links to its government record.</li>
      <li>AMSC: latest observed value from {nsn.amscSourceUrl ? <a href={nsn.amscSourceUrl} target="_blank" rel="noopener noreferrer">DIBBS solicitation history</a> : 'DIBBS solicitation history'}{nsn.amscObservedOn && <> as of {formatDate(nsn.amscObservedOn)}</>}.</li>
      <li>Contract action totals: USAspending, context only.</li>
      {lastUpdated && <li>Data last refreshed: {new Date(lastUpdated).toISOString().slice(0, 10)}.</li>}
      <li><a href="/methodology/">Full methodology →</a></li>
    </ul>
    <CiteThis title={itemLabel} url={canonicalUrl} asOf={citeAsOf} />
  </section>
</BaseLayout>
